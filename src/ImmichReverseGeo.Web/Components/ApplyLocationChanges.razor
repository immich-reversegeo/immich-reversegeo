@using System.Threading
@inject LocationManagementService Management
@inject LocationChangeRepository Changes
@inject PreviewCircuitLifetime Lifetime
@implements IDisposable

<section class="settings-card location-apply-panel">
    <h3 class="review-focus-target" tabindex="-1" @ref="_reviewHeading">@(_reviewed is null ? "Apply Selected Changes" : $"Review {_reviewed.Count} selected changes")</h3>
    <p class="hint">Applies exact saved names; later edits are skipped. Select up to 1,000 differences.</p>
    @if (_reviewed is null)
    {
        <button class="btn btn-primary" @ref="_reviewButton" @onclick="ReviewFromPanelAsync" disabled="@(Disabled || _busy || SelectedIds.Count == 0)">Review @SelectedIds.Count Selected Changes</button>
    }
    else
    {
        <p>@_reviewed.Count @(_reviewed.Count == 1 ? "asset" : "assets") will be checked against the existing names and GPS coordinates saved in this scan.</p>
        <LocationChangeTable Rows="_reviewed.Skip((_page - 1) * 100).Take(100)" />
        <div class="btn-row">
            <button class="btn btn-secondary" disabled="@(_busy || _page == 1)" @onclick="() => _page--">Previous 100</button>
            <button class="btn btn-secondary" disabled="@(_busy || _page * 100 >= _reviewed.Count)" @onclick="() => _page++">Next 100</button>
        </div>
        <p>Take an Immich database backup before continuing. Change History saves the previous names for guarded undo;
            it does not replace a database backup.</p>
        <label><input type="checkbox" @bind="_acknowledged" disabled="@_busy" /> I have reviewed these changes and understand that they update Immich.</label>
        <div class="btn-row">
            <button class="btn btn-primary" @onclick="ApplyAsync" disabled="@(Disabled || _busy || !_acknowledged)">Confirm Apply @_reviewed.Count Changes</button>
            <button class="btn btn-secondary" @onclick="BackToSelectionAsync" disabled="@_busy">Back to Selection</button>
        </div>
    }
    @if (_busy && _operationId is not null)
    {
        <p role="status">Applying selected changes…</p>
        <button class="btn btn-secondary" @onclick="Cancel">Cancel Remaining Work</button>
    }
    @if (_summary is not null)
    {
        <p role="status">Applied: @_summary.Applied; skipped: @_summary.Skipped; needs review: @_summary.NeedsReview; pending: @_summary.Pending.</p>
    }
    @if (_operationId is not null)
    {
        <p><a class="text-link" href="@($"/data/location-management/history/{_operationId}")">View this operation and undo selected changes</a>.</p>
    }
    @if (_error is not null)
    {
        <p class="alert alert-error" role="alert" tabindex="-1" @ref="_errorMessage">@_error</p>
    }
</section>

@code {
    [Parameter] public Guid? ScanId { get; set; }
    [Parameter] public IReadOnlyList<Guid> SelectedIds { get; set; } = [];
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<bool> BusyChanged { get; set; }
    [Parameter] public EventCallback<IReadOnlyList<LocationChangeItem>> ResultsChanged { get; set; }
    [Parameter] public EventCallback<bool> ReviewChanged { get; set; }
    [Parameter] public EventCallback SelectionFocusRequested { get; set; }
    private ElementReference _reviewHeading;
    private ElementReference _reviewButton;
    private ElementReference _errorMessage;
    private bool _reviewFromBar;
    private bool _focusHeading;
    private bool _focusSelection;
    private bool _focusError;

    private IReadOnlyList<LocationPreviewRow>? _reviewed;
    private Guid[] _reviewedIds = [];
    private Guid? _reviewedScanId;
    private Guid? _operationId;
    private Guid? _loadedScanId;
    private LocationChangeOperation? _summary;
    private CancellationTokenSource? _cts;
    private bool _busy;
    private bool _acknowledged;
    private bool _disposed;
    private int _page = 1;
    private string? _error;

    protected override void OnInitialized() => Lifetime.Disconnected += Cancel;
    protected override async Task OnParametersSetAsync()
    {
        if (!_busy && _loadedScanId != ScanId)
        {
            _loadedScanId = ScanId;
            var hadReview = _reviewed is not null;
            ClearReview();
            if (hadReview)
            {
                await ReviewChanged.InvokeAsync(false);
            }
            _operationId = null;
            _summary = null;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed)
        {
            return;
        }
        if (_focusHeading)
        {
            _focusHeading = false;
            await _reviewHeading.FocusAsync();
        }
        else if (_focusError)
        {
            _focusError = false;
            await _errorMessage.FocusAsync();
        }
        else if (_focusSelection)
        {
            _focusSelection = false;
            await FocusSelectionAsync();
        }
    }

    public Task ReviewFromSelectionAsync()
    {
        _reviewFromBar = true;
        return ReviewAsync();
    }

    private Task ReviewFromPanelAsync()
    {
        _reviewFromBar = false;
        return ReviewAsync();
    }

    public ValueTask FocusSelectionAsync() => SelectedIds.Count > 0 ? _reviewButton.FocusAsync() : _reviewHeading.FocusAsync();

    private async Task BackToSelectionAsync()
    {
        ClearReview();
        await ReviewChanged.InvokeAsync(false);
        if (_reviewFromBar)
        {
            await SelectionFocusRequested.InvokeAsync();
        }
        else
        {
            _focusSelection = true;
        }
    }

    private async Task ReviewAsync()
    {
        if (_busy || Disabled || ScanId is not { } id) { return; }
        _error = null;
        _busy = true;
        await BusyChanged.InvokeAsync(true);
        try
        {
            _reviewedIds = SelectedIds.Distinct().ToArray();
            var reviewed = await Management.ReviewAsync(id, _reviewedIds);
            if (_disposed || ScanId != id)
            {
                return;
            }
            _reviewed = reviewed;
            _reviewedScanId = id;
            _focusHeading = true;
            await ReviewChanged.InvokeAsync(true);
            _page = 1;
            _acknowledged = false;
        }
        catch (Exception ex) { _error = ex.Message; _focusError = true; }
        finally
        {
            _busy = false;
            if (!_disposed)
            {
                await BusyChanged.InvokeAsync(false);
            }
        }
    }

    private async Task ApplyAsync()
    {
        if (_busy || Disabled || !_acknowledged || _reviewed is null
            || _reviewedScanId is not { } id || ScanId != id)
        {
            return;
        }
        _busy = true;
        _operationId = null;
        _summary = null;
        _error = null;
        await BusyChanged.InvokeAsync(true);
        _cts = new CancellationTokenSource();
        try
        {
            _operationId = await Management.CreateApplyAsync(id, _reviewedIds);
            await InvokeAsync(StateHasChanged);
            await Management.RunAsync(_operationId.Value, undo: false, updated: RefreshSummaryAsync, ct: _cts.Token);
        }
        catch (Exception ex) { _error = ex.Message; _focusError = true; }
        finally
        {
            if (_operationId is { } operation)
            {
                try
                {
                    await RefreshSummaryAsync();
                    if (!_disposed && ScanId == id) { await ResultsChanged.InvokeAsync(await Changes.GetItemsAsync(operation)); }
                }
                catch (Exception ex) { _error = "Could not refresh change results: " + ex.Message; }
            }
            _busy = false;
            _cts.Dispose();
            _cts = null;
            ClearReview();
            if (!_disposed)
            {
                await ReviewChanged.InvokeAsync(false);
                await BusyChanged.InvokeAsync(false);
            }
        }
    }

    private async Task RefreshSummaryAsync()
    {
        if (_operationId is not { } id) { return; }
        _summary = (await Changes.GetOperationsAsync(id: id)).SingleOrDefault();
        if (!_disposed) { await InvokeAsync(StateHasChanged); }
    }

    private void ClearReview()
    {
        _reviewed = null;
        _reviewedIds = [];
        _reviewedScanId = null;
        _acknowledged = false;
        _page = 1;
    }
    private void Cancel() => _cts?.Cancel();
    public void Dispose()
    {
        _disposed = true;
        Lifetime.Disconnected -= Cancel;
        Cancel();
    }
}

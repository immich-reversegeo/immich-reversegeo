@page "/data/saved-previews/{Id:guid}"
@page "/data/location-management/scans/{Id:guid}"
@rendermode InteractiveServer
@inject LocationChangeRepository Changes
@inject LocationReviewResults Results
@inject SavedLocationPreviewRepository Saved
@inject NavigationManager Navigation

<PageTitle>Saved Scan - Immich ReverseGeo</PageTitle>
<h2>Saved Scan</h2>
<LocationManagementNav ActiveSection="scans" />
<p><a class="text-link" href="/data/location-management/scans">All saved scans</a></p>
@if (_error is not null)
{
    <p class="alert alert-error" role="alert">@_error</p>
}
@if (_loading)
{
    <p role="status">Loading saved results…</p>
}
else if (_report is null)
{
    <p>This saved scan was not found.</p>
}
else
{
    <section class="settings-card wide-card">
        <p>Started: <LocalTimestamp Timestamp="_report.CreatedAt" />. Last saved: <LocalTimestamp Timestamp="_report.UpdatedAt" />.</p>
        <p>Status: @_report.Status. @_report.CheckedCount checked; @_report.DifferentCount different.</p>
        <p>Selection: @SelectionLabel. Order: @(_report.Selection.Order == LocationPreviewOrder.NearbyCoordinates ? "Nearby coordinates" : "Asset GUID").</p>
        <p>Scan mode: @(_report.Selection.ScanMode == LocationPreviewScanMode.Continuous ? "Continuous" : "Manual pages").
            @if (_report.Selection.ScanMode == LocationPreviewScanMode.Continuous)
            {
                <span>Pause after differences: @(_report.Selection.PauseAfterDifferences == 0 ? "No limit" : _report.Selection.PauseAfterDifferences.ToString()).</span>
            }
        </p>
        <p>These are saved snapshots, not live Immich values. Opening this report does not run lookups or change Immich.
            Start a new scan if you need current results. Only checked assets are saved; this report may cover part of the selection.</p>
        @if (_report.Error is not null)
        {
            <p class="alert alert-error">@_report.Error</p>
        }
        <details>
            <summary>Processing settings used</summary>
            <p>Airport names: @(_report.Settings.UseAirportInfrastructure ? "enabled" : "disabled").
                GADM administrative areas: @(_report.Settings.UseGadmAdministrativeAreas ? "enabled" : "disabled").
                Preferred administrative source: @(_report.Settings.UseGadmAdministrativeAreas && _report.Settings.PreferGadmAdministrativeAreas ? "GADM" : "Overture").</p>
        </details>
        <div class="btn-row">
            <button class="btn btn-secondary" disabled="@(_loading || _applying)" @onclick="LoadAsync">Refresh saved results</button>
            <button class="btn btn-secondary" disabled="@(_loading || _applying || _report.Status == "Running")" @onclick="() => _confirmDelete = true">Delete saved report</button>
        </div>
        @if (_confirmDelete)
        {
            <p>Delete this report and its saved results? Immich metadata will not be changed.</p>
            <div class="btn-row">
                <button class="btn btn-secondary" disabled="@(_loading || _applying)" @onclick="DeleteAsync">Confirm delete</button>
                <button class="btn btn-secondary" @onclick="() => _confirmDelete = false">Keep report</button>
            </div>
        }
    </section>
    <section class="settings-card wide-card">
        <h3>Saved results — page @_page</h3>
        <ImmichPhotoSetup />
        <div class="form-group">
            <label for="saved-result-filter">Show results</label>
            <select id="saved-result-filter" class="form-control" @bind="_resultFilter" @bind:after="FilterAsync" disabled="@(_loading || _applying)">
                <option value="@LocationReviewFilter.Ready">Ready to apply</option>
                <option value="@LocationReviewFilter.Applied">Applied</option>
                <option value="@LocationReviewFilter.Attention">Needs attention</option>
                <option value="@LocationReviewFilter.All">All results</option>
            </select>
            <span class="hint">Ready to apply shows differences not yet attempted. Resume pending work in Change History; run a new scan for skipped or undone changes.</span>
        </div>
        <p class="hint">Highlighted characters differ between the existing and proposed names.
            Changed spaces appear as ␠; other invisible characters use symbols or Unicode codes. Hover over a highlight for character codes.</p>
        @if (_rows.Count == 0)
        {
            <p>No results match this filter. Choose All results to inspect the saved snapshots.</p>
        }
        else
        {
            <div class="btn-row">
                <button class="btn btn-secondary" disabled="@(_loading || _applying || !_rows.Take(100).Any(CanSelect))" @onclick="SelectPageChanges">Select different values on this page</button>
                <button class="btn btn-secondary" @onclick="_review.Clear" disabled="@(_applying || _review.Count == 0)">Clear selection</button>
            </div>
            <div class="table-scroll">
                <table class="data-table">
                    <thead><tr><th>Select</th><th>Photo</th><th>Asset GUID</th><th>Existing location</th><th>Proposed location</th><th>Result</th></tr></thead>
                    <tbody>
                        @foreach (var row in _rows.Take(100))
                        {
                            <tr>
                                <td><input type="checkbox" aria-label="Select asset @row.Asset.Id" checked="@_review.IsSelected(row.Asset.Id)"
                                    disabled="@(_applying || !CanSelect(row))" @onchange="args => _review.Select(row, args.Value is true)" /></td>
                                <td><PreviewPhoto AssetId="row.Asset.Id" PreviewId="Id" /></td>
                                <td><code>@row.Asset.Id</code><div class="hint">GPS: @row.Asset.Latitude?.ToString("G", System.Globalization.CultureInfo.InvariantCulture), @row.Asset.Longitude?.ToString("G", System.Globalization.CultureInfo.InvariantCulture)</div></td>
                                <td><div>City: <LocationDiffValue Value="@row.Asset.Existing.City" OtherValue="@row.Proposed?.City" Highlight="@row.HasChange" /></div><div>State: <LocationDiffValue Value="@row.Asset.Existing.State" OtherValue="@row.Proposed?.State" Highlight="@row.HasChange" /></div><div>Country: <LocationDiffValue Value="@row.Asset.Existing.Country" OtherValue="@row.Proposed?.Country" Highlight="@row.HasChange" /></div></td>
                                <td><div>City: <LocationDiffValue Value="@row.Proposed?.City" OtherValue="@row.Asset.Existing.City" Highlight="@row.HasChange" /></div><div>State: <LocationDiffValue Value="@row.Proposed?.State" OtherValue="@row.Asset.Existing.State" Highlight="@row.HasChange" /></div><div>Country: <LocationDiffValue Value="@row.Proposed?.Country" OtherValue="@row.Asset.Existing.Country" Highlight="@row.HasChange" /></div></td>
                                <td>@(_changeResults.TryGetValue(row.Asset.Id, out var outcome) ? outcome.Label : row.Status)
                                @if (_changeResults.TryGetValue(row.Asset.Id, out var change))
                                {
                                    <div class="hint">@change.Message</div>
                                    <a class="text-link" href="@($"/data/location-management/history/{change.OperationId}")">View change</a>
                                }
                                    @if (row.Error is not null)
                                    {
                                        <div>@row.Error</div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        <div class="btn-row">
            <button class="btn btn-secondary" disabled="@(_loading || _applying || _page == 1)" @onclick="PreviousAsync">Previous 100</button>
            <button class="btn btn-secondary" disabled="@(_loading || _applying || _rows.Count <= 100)" @onclick="NextAsync">Next 100</button>
        </div>
        @if (_review.Count > 0)
        {
            <div class="form-group">
                <label for="saved-preview-guids">Selected GUIDs (@_review.Count)</label>
                <textarea id="saved-preview-guids" class="form-control reset-textarea" readonly value="@string.Join(Environment.NewLine, _review.SelectedIds)"></textarea>
            </div>
            <p>Selections are kept across pages while this scan is open. Review and apply the exact saved proposals below; assets with changed names or coordinates are skipped.</p>
        }
        <ApplyLocationChanges ScanId="Id" SelectedIds="_review.SelectedIds" Disabled="_loading" BusyChanged="busy => _applying = busy" ResultsChanged="OnChangeResults" />
    </section>
}

@code {
    [Parameter] public Guid Id { get; set; }
    private SavedLocationPreview? _report;
    private IReadOnlyList<LocationPreviewRow> _rows = [];
    private LocationPreviewReview _review = new();
    private Guid? _loadedId;
    private long _loadVersion;
    private bool _loading;
    private bool _applying;
    private Dictionary<Guid, LocationChangeItem> _changeResults = new();
    private LocationReviewFilter _resultFilter = LocationReviewFilter.Ready;
    private bool CanSelect(LocationPreviewRow row) => row.HasChange && !_changeResults.ContainsKey(row.Asset.Id);
    private bool _confirmDelete;
    private int _page = 1;
    private string? _error;

    private string SelectionLabel => _report!.Selection.Scope switch
    {
        LocationPreviewScope.All => "Whole library (GPS only)",
        LocationPreviewScope.AssetIds => $"{_report.Selection.AssetIds.Length} GUID(s)",
        _ => $"{_report.Selection.Scope}: {_report.Selection.Value}"
    };

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId != Id)
        {
            _page = 1;
            _review.Clear();
            _confirmDelete = false;
            _report = null;
            _rows = [];
            _resultFilter = LocationReviewFilter.Ready;
            _loadedId = Id;
        }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var version = ++_loadVersion;
        var requestedId = Id;
        var requestedPage = _page;
        var filter = _resultFilter;
        _loading = true;
        _error = null;
        try
        {
            var report = (await Saved.GetReportsAsync(id: requestedId)).SingleOrDefault();
            var rows = report is null ? [] : await Results.GetRowsAsync(requestedId, requestedPage, filter);
            while (report is not null && requestedPage > 1 && rows.Count == 0)
            {
                requestedPage--;
                rows = await Results.GetRowsAsync(requestedId, requestedPage, filter);
            }
            var results = await Changes.GetScanResultsAsync(requestedId, rows.Take(100).Select(row => row.Asset.Id).ToArray());
            if (version != _loadVersion || requestedId != Id)
            {
                return;
            }
            _report = report;
            _page = requestedPage;
            _rows = rows;
            _changeResults = new Dictionary<Guid, LocationChangeItem>(results);
        }
        catch (Exception ex)
        {
            if (version == _loadVersion)
            {
                _error = $"Could not load saved scan: {ex.Message}";
            }
        }
        finally
        {
            if (version == _loadVersion)
            {
                _loading = false;
            }
        }
    }

    private Task FilterAsync()
    {
        _page = 1;
        return LoadAsync();
    }

    private Task PreviousAsync()
    {
        _page--;
        return LoadAsync();
    }

    private Task NextAsync()
    {
        _page++;
        return LoadAsync();
    }

    private async Task OnChangeResults(IReadOnlyList<LocationChangeItem> items)
    {
        _review.Clear();
        await LoadAsync();
    }
    private void SelectPageChanges()
    {
        foreach (var row in _rows.Take(100).Where(CanSelect))
        {
            _review.Select(row, true);
        }
    }

    private async Task DeleteAsync()
    {
        if (_loading || _applying)
        {
            return;
        }
        var requestedId = Id;
        _confirmDelete = false;
        try
        {
            if (await Saved.DeleteAsync(requestedId))
            {
                if (requestedId != Id)
                {
                    return;
                }
                Navigation.NavigateTo("/data/location-management/scans");
            }
            else
            {
                _error = "The report is running or has already been deleted. Refresh saved results to check its status.";
            }
        }
        catch (Exception ex)
        {
            _error = $"Could not delete saved scan: {ex.Message}";
        }
    }
}

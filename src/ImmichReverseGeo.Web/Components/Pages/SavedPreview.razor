@page "/data/saved-previews/{Id:guid}"
@page "/data/location-management/scans/{Id:guid}"
@rendermode InteractiveServer
@inject LocationChangeRepository Changes
@inject LocationReviewResults Results
@inject SavedLocationPreviewRepository Saved
@inject NavigationManager Navigation

<PageTitle>Saved Scan - Immich ReverseGeo</PageTitle>
<h2>Saved Scan</h2>
<LocationManagementNav ActiveSection="scans" />
<p class="page-desc">Review saved proposals or continue unfinished work. Opening this report does not change Immich.</p>
<p><a class="text-link" href="/data/location-management/scans">All saved scans</a></p>
@if (_error is not null)
{
    <p class="alert alert-error" role="alert">@_error</p>
}
@if (_loading)
{
    <p role="status">Loading saved results…</p>
}
else if (_report is null)
{
    <p>This saved scan was not found.</p>
}
else
{
    <section class="settings-card wide-card">
        <h3>Saved scan summary</h3>
        <dl class="location-metadata">
            <div><dt>Status</dt><dd>@_report.StatusLabel</dd></div>
            <div><dt>Checked</dt><dd>@_report.CheckedCount.ToString("N0") / @(_report.Checkpoint?.TotalCount?.ToString("N0") ?? "—")</dd></div>
            <div><dt>Different</dt><dd>@_report.DifferentCount.ToString("N0")</dd></div>
            <div><dt>Active scan time</dt><dd>@(_report.Checkpoint is null ? "—" : TimeSpan.FromTicks(_report.Checkpoint.ActiveTicks).ToString(@"hh\:mm\:ss"))</dd></div>
            <div><dt>Started</dt><dd><LocalTimestamp Timestamp="_report.CreatedAt" /></dd></div>
            <div><dt>Last saved</dt><dd><LocalTimestamp Timestamp="_report.UpdatedAt" /></dd></div>
            <div><dt>Selection</dt><dd>@SelectionLabel</dd></div>
            <div><dt>Scan mode</dt><dd>@(_report.Selection.ScanMode == LocationPreviewScanMode.Continuous ? "Continuous" : "Manual pages")</dd></div>
        </dl>
        @if (_report.Status == "Paused")
        {
            <p class="preview-pause-status" role="status">Paused for review after @(_report.Checkpoint?.PausedDifferences ?? _report.Selection.PauseAfterDifferences) new differences. Review results, then continue when ready.</p>
        }
        @if (_report.Error is not null)
        {
            <p class="alert alert-error" role="alert">@_report.Error</p>
        }
        @if (_report.Settings.UseGadmAdministrativeAreas)
        {
            <p class="hint">This scan uses GADM data, licensed for non-commercial use.</p>
        }
        <ImmichPhotoSetup ShowHelp="false" />
        <div class="btn-row">
            @if (_report.CanResume && !_applying)
            {
                <a class="btn btn-primary" href="@($"/data/location-management/scans/{Id}/continue")">Continue scan</a>
            }
            <button class="btn btn-secondary" disabled="@(_loading || _applying)" @onclick="LoadAsync">Refresh saved results</button>
        </div>
        <details class="location-help">
            <summary>Original settings and snapshot limits</summary>
            <dl class="location-metadata">
                <div><dt>Order</dt><dd>@(_report.Selection.Order == LocationPreviewOrder.NearbyCoordinates ? "Nearby coordinates" : "Asset GUID")</dd></div>
                <div><dt>Pause after differences</dt><dd>@(_report.Selection.PauseAfterDifferences == 0 ? "No limit" : _report.Selection.PauseAfterDifferences.ToString("N0"))</dd></div>
                <div><dt>Airport names</dt><dd>@(_report.Settings.UseAirportInfrastructure ? "Enabled" : "Disabled")</dd></div>
                <div><dt>GADM administrative areas</dt><dd>@(_report.Settings.UseGadmAdministrativeAreas ? "Enabled (non-commercial)" : "Disabled")</dd></div>
                <div><dt>Preferred source</dt><dd>@(_report.Settings.UseGadmAdministrativeAreas && _report.Settings.PreferGadmAdministrativeAreas ? "GADM" : "Overture")</dd></div>
                <div><dt>Low-memory mode</dt><dd>@(_report.Settings.LowMemoryMode ? "Enabled" : "Disabled")</dd></div>
            </dl>
            <p>These are saved snapshots, not live Immich values. Only checked assets are saved; the report may cover part of the selection. Start a new scan for current proposals or changed settings.</p>
        </details>
        <details class="location-help">
            <summary>Report maintenance</summary>
            <button class="btn btn-secondary" disabled="@(_loading || _applying || _report.Status == "Running")" @onclick="() => _confirmDelete = true">Delete saved report</button>
            @if (_confirmDelete)
            {
                <p>Delete this report and its saved results? Immich metadata will not be changed.</p>
                <div class="btn-row">
                    <button class="btn btn-secondary" disabled="@(_loading || _applying)" @onclick="DeleteAsync">Confirm delete</button>
                    <button class="btn btn-secondary" @onclick="() => _confirmDelete = false">Keep report</button>
                </div>
            }
            </details>
    </section>
    <section class="settings-card wide-card">
        <div class="location-section-header"><h3>Review saved results</h3><span class="hint">Page @_page · @_review.Count selected</span></div>

        <div class="review-filter-bar">
            <label><input type="checkbox" @bind="_onlyChanges" @bind:after="FilterAsync" disabled="@(_loading || _applying)" /> Show only different values</label>

            <label for="saved-result-filter">Show results</label>
            <select id="saved-result-filter" class="form-control" @bind="_resultFilter" @bind:after="FilterAsync" disabled="@(_loading || _applying)">
                <option value="@LocationReviewFilter.Ready">Ready to apply</option>
                <option value="@LocationReviewFilter.Applied">Applied</option>
                <option value="@LocationReviewFilter.Attention">Needs attention</option>
                <option value="@LocationReviewFilter.All">All results</option>
            </select>

        </div>
        <div class="btn-row">
            <button class="btn btn-secondary" disabled="@(_loading || _applying || !_rows.Take(100).Any(CanSelect))" @onclick="SelectPageChanges">Select different values on this page</button>
            <button class="btn btn-secondary" @onclick="_review.Clear" disabled="@(_applying || _review.Count == 0)">Clear selection</button>
        </div>
        <div class="review-actions">
            <ApplyLocationChanges @ref="_applyReview" ReviewChanged="reviewing => _reviewing = reviewing" SelectionFocusRequested="RequestSelectionFocus" ScanId="Id" SelectedIds="_review.SelectedIds" Disabled="_loading" BusyChanged="busy => _applying = busy" ResultsChanged="OnChangeResults" />
        </div>
        @if (_rows.Count == 0)
        {
            <p>No results match this filter. Choose All results to inspect the saved snapshots.</p>
        }
        else
        {
            <div class="table-scroll" role="region" aria-label="Saved location comparisons; scroll horizontally to see all columns" tabindex="0">
                <table class="data-table">
                    <thead><tr><th scope="col">Select</th><th scope="col">Photo</th><th scope="col">Asset GUID</th><th scope="col">Existing location</th><th scope="col">Proposed location</th><th scope="col">Result</th></tr></thead>
                    <tbody>
                        @foreach (var row in _rows.Take(100))
                        {
                            <tr>
                                <td><input type="checkbox" aria-label="Select asset @row.Asset.Id" checked="@_review.IsSelected(row.Asset.Id)"
                                    disabled="@(_applying || !CanSelect(row))" @onchange="args => _review.Select(row, args.Value is true)" /></td>
                                <td><PreviewPhoto AssetId="row.Asset.Id" PreviewId="Id" LoadPreview="@row.HasChange" /></td>
                                <td><code>@row.Asset.Id</code><div class="hint">GPS: @row.Asset.Latitude?.ToString("G", System.Globalization.CultureInfo.InvariantCulture), @row.Asset.Longitude?.ToString("G", System.Globalization.CultureInfo.InvariantCulture)</div></td>
                                <td><div>City: <LocationDiffValue Value="@row.Asset.Existing.City" OtherValue="@row.Proposed?.City" Highlight="@row.HasChange" /></div><div>State: <LocationDiffValue Value="@row.Asset.Existing.State" OtherValue="@row.Proposed?.State" Highlight="@row.HasChange" /></div><div>Country: <LocationDiffValue Value="@row.Asset.Existing.Country" OtherValue="@row.Proposed?.Country" Highlight="@row.HasChange" /></div></td>
                                <td><div>City: <LocationDiffValue Value="@row.Proposed?.City" OtherValue="@row.Asset.Existing.City" Highlight="@row.HasChange" /></div><div>State: <LocationDiffValue Value="@row.Proposed?.State" OtherValue="@row.Asset.Existing.State" Highlight="@row.HasChange" /></div><div>Country: <LocationDiffValue Value="@row.Proposed?.Country" OtherValue="@row.Asset.Existing.Country" Highlight="@row.HasChange" /></div></td>
                                <td>@(_changeResults.TryGetValue(row.Asset.Id, out var outcome) ? outcome.Label : row.Status)
                                @if (_changeResults.TryGetValue(row.Asset.Id, out var change))
                                {
                                    <div class="hint">@change.Message</div>
                                    <a class="text-link" href="@($"/data/location-management/history/{change.OperationId}")">View change</a>
                                }
                                    @if (row.Error is not null)
                                    {
                                        <div>@row.Error</div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        <div class="btn-row">
            <button class="btn btn-secondary" disabled="@(_loading || _applying || _page == 1)" @onclick="PreviousAsync">Previous 100</button>
            <button class="btn btn-secondary" disabled="@(_loading || _applying || _rows.Count <= 100)" @onclick="NextAsync">Next 100</button>
        </div>
        @if (_review.Count > 0)
        {
            <details class="location-help"><summary>Selected asset GUIDs (@_review.Count)</summary>
                <div class="form-group">
                    <label for="saved-preview-guids">Selected GUIDs (@_review.Count)</label>
                    <textarea id="saved-preview-guids" class="form-control reset-textarea" readonly value="@string.Join(Environment.NewLine, _review.SelectedIds)"></textarea>
                </div>
                <p>Selections are kept across pages while this scan is open. Review and apply the exact saved proposals above; assets with changed names or coordinates are skipped.</p>
            </details>
        }

        <LocationReviewHelp />
        @if (_review.Count > 0 && !_reviewing)
        {
            <LocationSelectionBar @ref="_selectionBar" Count="_review.Count" Disabled="@(_loading || _applying)"
                Clear="ClearFromSelectionBar" Review="ReviewFromSelectionBarAsync" />
        }
    </section>
}

@code {
    private ApplyLocationChanges? _applyReview;
    private LocationSelectionBar? _selectionBar;
    private bool _reviewing;
    private bool _focusSelectionBar;

    private Task ReviewFromSelectionBarAsync() => _applyReview?.ReviewFromSelectionAsync() ?? Task.CompletedTask;
    private void RequestSelectionFocus() => _focusSelectionBar = true;
    private void ClearFromSelectionBar()
    {
        _review.Clear();
        RequestSelectionFocus();
    }
    private async Task FocusSelectionBarAsync()
    {
        if (!_focusSelectionBar || _loading || _applying)
        {
            return;
        }
        _focusSelectionBar = false;
        if (_review.Count > 0 && !_reviewing && _selectionBar is not null)
        {
            await _selectionBar.FocusReviewAsync();
        }
        else if (_applyReview is not null)
        {
            await _applyReview.FocusSelectionAsync();
        }
    }

    [Parameter] public Guid Id { get; set; }
    private SavedLocationPreview? _report;
    private IReadOnlyList<LocationPreviewRow> _rows = [];
    private LocationPreviewReview _review = new();
    private Guid? _loadedId;
    private long _loadVersion;
    private bool _loading;
    private bool _applying;
    private Dictionary<Guid, LocationChangeItem> _changeResults = new();
    private bool _onlyChanges = true;
    private LocationReviewFilter _resultFilter = LocationReviewFilter.Ready;
    private bool CanSelect(LocationPreviewRow row) => row.HasChange && !_changeResults.ContainsKey(row.Asset.Id);
    private bool _confirmDelete;
    private int _page = 1;
    private string? _error;

    private string SelectionLabel => _report!.Selection.Scope switch
    {
        LocationPreviewScope.All => "Whole library (GPS only)",
        LocationPreviewScope.AssetIds => $"{_report.Selection.AssetIds.Length} GUID(s)",
        _ => $"{_report.Selection.Scope}: {_report.Selection.Value}"
    };

    protected override Task OnAfterRenderAsync(bool firstRender) => FocusSelectionBarAsync();

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId != Id)
        {
            _page = 1;
            _review.Clear();
            _confirmDelete = false;
            _report = null;
            _rows = [];
            _resultFilter = LocationReviewFilter.Ready;
            _onlyChanges = true;
            _loadedId = Id;
        }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var version = ++_loadVersion;
        var requestedId = Id;
        var requestedPage = _page;
        var filter = _resultFilter;
        var onlyChanges = _onlyChanges;
        _loading = true;
        _reviewing = false;
        _error = null;
        try
        {
            var report = (await Saved.GetReportsAsync(id: requestedId)).SingleOrDefault();
            var rows = report is null ? [] : await Results.GetRowsAsync(requestedId, requestedPage, filter, onlyChanges);
            while (report is not null && requestedPage > 1 && rows.Count == 0)
            {
                requestedPage--;
                rows = await Results.GetRowsAsync(requestedId, requestedPage, filter, onlyChanges);
            }
            var results = await Changes.GetScanResultsAsync(requestedId, rows.Take(100).Select(row => row.Asset.Id).ToArray());
            if (version != _loadVersion || requestedId != Id)
            {
                return;
            }
            _report = report;
            _page = requestedPage;
            _rows = rows;
            _changeResults = new Dictionary<Guid, LocationChangeItem>(results);
        }
        catch (Exception ex)
        {
            if (version == _loadVersion)
            {
                _error = $"Could not load saved scan: {ex.Message}";
            }
        }
        finally
        {
            if (version == _loadVersion)
            {
                _loading = false;
            }
        }
    }

    private Task FilterAsync()
    {
        _page = 1;
        return LoadAsync();
    }

    private Task PreviousAsync()
    {
        _page--;
        return LoadAsync();
    }

    private Task NextAsync()
    {
        _page++;
        return LoadAsync();
    }

    private async Task OnChangeResults(IReadOnlyList<LocationChangeItem> items)
    {
        _review.Clear();
        await LoadAsync();
    }
    private void SelectPageChanges()
    {
        foreach (var row in _rows.Take(100).Where(CanSelect))
        {
            _review.Select(row, true);
        }
    }

    private async Task DeleteAsync()
    {
        if (_loading || _applying)
        {
            return;
        }
        var requestedId = Id;
        _confirmDelete = false;
        try
        {
            if (await Saved.DeleteAsync(requestedId))
            {
                if (requestedId != Id)
                {
                    return;
                }
                Navigation.NavigateTo("/data/location-management/scans");
            }
            else
            {
                _error = "The report is running or has already been deleted. Refresh saved results to check its status.";
            }
        }
        catch (Exception ex)
        {
            _error = $"Could not delete saved scan: {ex.Message}";
        }
    }
}

@page "/logs"
@rendermode InteractiveServer
@inject ProcessingState State
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Logs - Immich ReverseGeo</PageTitle>

<h2>Logs</h2>
<p class="run-info">Times are shown in your browser's timezone. Downloads use UTC.</p>
<p class="hint">Only the latest 100 activity entries are kept, and they are cleared when the app restarts. The download contains the current filtered view.</p>

<div class="log-controls">
    <label>Filter
        <select @bind="_levelFilter">
            <option value="">All</option>
            <option value="[ERROR]">Errors only</option>
            <option value="[WARN]">Warnings+</option>
        </select>
    </label>
    <label>
        <input type="checkbox" @bind="_followLogs" />
        Follow logs
    </label>
    <button @onclick="DownloadLog" class="btn btn-secondary" disabled="@(!FilteredLog.Any())">↓ Download Filtered Recent Logs</button>
</div>
@if (!FilteredLog.Any())
{
    <p role="status">No recent entries match this filter.</p>
}

<div class="log-full" @ref="_logContainer">
    @foreach (var entry in FilteredLog)
    {
        <div class="log-line @(entry.Message.Contains("[ERROR]") ? "error" : entry.Message.Contains("[WARN]") ? "warn" : "")">[<LocalTimestamp Timestamp="entry.Timestamp" />] @entry.Message</div>
    }
</div>

@code {
    private string _levelFilter = "";
    private bool _followLogs = true;
    private ElementReference _logContainer;

    private IEnumerable<ProcessingLogEntry> FilteredLog =>
        State.GetRecentLogEntries().Where(entry => entry.MatchesFilter(_levelFilter));

    protected override void OnInitialized() => State.OnChanged += Refresh;
    public void Dispose() => State.OnChanged -= Refresh;
    private void Refresh() => InvokeAsync(StateHasChanged);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_followLogs)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("scrollLogsToBottom", _logContainer);
        }
        catch (JSDisconnectedException)
        {
            // The page can disconnect while an activity update is rendering.
        }
    }

    private async Task DownloadLog()
    {
        var content = string.Join("\n", FilteredLog.Select(entry => entry.ToUtcString()));
        var bytes = System.Text.Encoding.UTF8.GetBytes(content);
        var base64 = Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("downloadFile", "immich-reversegeo.log", "text/plain", base64);
    }
}

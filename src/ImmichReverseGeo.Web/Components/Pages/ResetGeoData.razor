@page "/data/reset-geo-data"
@rendermode InteractiveServer
@inject ImmichDbRepository Db
@inject SkippedAssetsRepository Skipped
@inject ProcessingState State
@inject ProcessingBackgroundService Processor
@inject LocationPreviewSession PreviewSession
@implements IDisposable

<PageTitle>Reset Immich Geo Data - Immich ReverseGeo</PageTitle>
<h2>Reset Immich Geo Data</h2>
<p class="section-intro"><a class="text-link" href="/data/location-preview">Preview location corrections</a> first, then reset only the assets you want to reprocess.</p>
<p>Reset clears city, state, and country names. GPS coordinates and other Immich metadata are kept. Take an Immich database backup before confirming a reset.</p>
@if (State.IsRunning)
{
    <p class="alert alert-info" role="status">Wait for processing to finish, or cancel it from the Dashboard, before resetting location names.</p>
}
@if (_error is not null)
{
    <p class="alert alert-error" role="alert">@_error</p>
}
@if (_result is not null)
{
    <section class="settings-card" role="status">
        <p>@_result</p>
        <a class="btn btn-primary" href="/">Go to Dashboard to Reprocess</a>
        <a class="text-link" href="/data/location-preview">Return to preview</a>
    </section>
}
@if (_busy)
{
    <p role="status">@_activity</p>
}
@if (_pending is not null)
{
    <section class="settings-card reset-confirmation" aria-labelledby="reset-confirm-title">
        <h3 id="reset-confirm-title">Review Reset</h3>
        <p><strong>@_pending.Description</strong></p>
        <p>Clear city, state, and country names for <strong>@_pending.Count.ToString("N0") assets</strong> with stored location names.</p>
        <p>@(_pending.Kind == ResetKind.All ? "The entire skip list will also be cleared." : "Selected assets will also be removed from the skip list, even if they have no location names to clear.")</p>
        <p>Reset does not apply the proposed names. Processing must run afterwards, and may produce different results if settings, coordinates, or source data have changed.</p>
        <div class="btn-row">
            <button class="btn btn-danger" @onclick="ConfirmResetAsync" disabled="@(_busy || State.IsRunning)">Confirm Reset</button>
            <button class="btn btn-secondary" @onclick="() => _pending = null" disabled="@_busy">Keep Location Names</button>
        </div>
    </section>
}
<fieldset class="maintenance-fields" disabled="@(_busy || _pending is not null || State.IsRunning)">
    <section class="settings-card">
        <h3>Reset Selected Assets</h3>
        @if (_fromPreview)
        {
            <p class="alert alert-info">Your reviewed preview selection is ready below. Review the reset before confirming.</p>
        }
        <div class="form-group">
            <label for="asset-reset-ids">Asset GUIDs</label>
            <textarea id="asset-reset-ids" class="form-control reset-textarea" @bind="_assetIdsInput" @bind:event="oninput" placeholder="Paste asset GUIDs separated by commas, spaces, or new lines"></textarea>
        </div>
        <button class="btn btn-secondary" @onclick="ReviewAssetsAsync" disabled="@string.IsNullOrWhiteSpace(_assetIdsInput)">Review Selected Assets</button>
    </section>
    <section class="settings-card">
        <h3>Reset by Existing Location</h3>
        <p>Select an existing location. The reset clears all three location fields for matching active assets.</p>
        @if (_loadingLocations)
        {
            <p role="status">Loading existing locations…</p>
        }
        @if (_locationLoadError is not null)
        {
            <p class="alert alert-error" role="alert">@_locationLoadError</p>
            <button class="btn btn-secondary" @onclick="LoadLocationOptionsAsync">Retry Loading Locations</button>
        }
        <div class="reset-select-grid">
            <div class="form-group">
                <label for="reset-scope">Match by</label>
                <select id="reset-scope" class="form-control" value="@_scope" @onchange="OnScopeChanged">
                    @foreach (var scope in Enum.GetValues<LocationResetScope>())
                    {
                        <option value="@scope">@scope</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label for="reset-sort">Sort locations</label>
                <select id="reset-sort" class="form-control" @bind="_sortByName">
                    <option value="false">Number of assets</option>
                    <option value="true">Name</option>
                </select>
            </div>
            <div class="form-group">
                <label for="reset-value">Existing location</label>
                <select id="reset-value" class="form-control" @bind="_value" disabled="@(_loadingLocations || _locationLoadError is not null)">
                    <option value="">Choose a location…</option>
                    @foreach (var option in CurrentOptions)
                    {
                        <option value="@option.Value">@option.Value (@option.AssetCount.ToString("N0"))</option>
                    }
                </select>
            </div>
        </div>
        @if (!_loadingLocations && _locationLoadError is null && !CurrentOptions.Any())
        {
            <p>No stored @_scope.ToString().ToLowerInvariant() names were found.</p>
        }
        <button class="btn btn-secondary" @onclick="ReviewLocationAsync" disabled="@string.IsNullOrWhiteSpace(_value)">Review Matching Assets</button>
    </section>
    <section class="settings-card">
        <details class="settings-disclosure">
            <summary>Advanced: Reset All Location Names</summary>
            <p>Clear names from every Immich metadata row with stored location names, including deleted assets, and clear the entire skip list. Use a targeted reset when possible.</p>
            <button class="btn btn-danger" @onclick="ReviewAllAsync">Review Full Reset</button>
        </details>
    </section>
</fieldset>

@code {
    private bool _busy, _fromPreview, _sortByName;
    private bool _loadingLocations = true;
    private string? _assetIdsInput, _value, _error, _result, _locationLoadError;
    private string _activity = "";
    private LocationResetScope _scope = LocationResetScope.City;
    private ResetRequest? _pending;
    private readonly Dictionary<LocationResetScope, IReadOnlyList<LocationValueOption>> _options = [];
    private IEnumerable<LocationValueOption> CurrentOptions => _sortByName
        ? _options.GetValueOrDefault(_scope, []).OrderBy(option => option.Value, StringComparer.OrdinalIgnoreCase)
        : _options.GetValueOrDefault(_scope, []).OrderByDescending(option => option.AssetCount).ThenBy(option => option.Value, StringComparer.OrdinalIgnoreCase);

    protected override void OnInitialized()
    {
        State.OnChanged += Refresh;
        var ids = PreviewSession.TakeResetIds();
        _fromPreview = ids.Length > 0;
        if (_fromPreview)
        {
            _assetIdsInput = string.Join(Environment.NewLine, ids);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadLocationOptionsAsync();
            StateHasChanged();
        }
    }

    private void Refresh() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => State.OnChanged -= Refresh;

    private async Task LoadLocationOptionsAsync()
    {
        _loadingLocations = true;
        _locationLoadError = null;
        try
        {
            var scopes = Enum.GetValues<LocationResetScope>();
            var results = await Task.WhenAll(scopes.Select(scope => Db.GetLocationValueOptionsAsync(scope)));
            for (var index = 0; index < scopes.Length; index++)
            {
                _options[scopes[index]] = results[index];
            }
            if (!CurrentOptions.Any(option => option.Value == _value))
            {
                _value = null;
            }
        }
        catch (Exception)
        {
            _locationLoadError = "Could not load locations. Check the database connection and retry. Your pasted GUIDs are still here.";
        }
        finally
        {
            _loadingLocations = false;
        }
    }

    private void OnScopeChanged(ChangeEventArgs args)
    {
        if (Enum.TryParse<LocationResetScope>(args.Value?.ToString(), out var scope))
        {
            _scope = scope;
            _value = null;
        }
    }

    private Task ReviewAssetsAsync()
    {
        _error = null;
        var ids = new HashSet<Guid>();
        foreach (var token in (_assetIdsInput ?? "").Split(['\r', '\n', ',', ';', ' ', '\t'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            if (!Guid.TryParse(token, out var id))
            {
                _error = $"Invalid asset GUID: {token}. Correct it before reviewing; nothing has been reset.";
                return Task.CompletedTask;
            }
            ids.Add(id);
        }
        return ids.Count == 0 ? Task.CompletedTask
            : ReviewAsync(new ResetRequest(ResetKind.Assets, ids.ToArray(), null, null, 0, $"{ids.Count:N0} selected asset GUIDs"));
    }

    private Task ReviewLocationAsync() => string.IsNullOrWhiteSpace(_value) ? Task.CompletedTask
        : ReviewAsync(new ResetRequest(ResetKind.Location, [], _scope, _value, 0, $"{_scope}: {_value}"));
    private Task ReviewAllAsync() => ReviewAsync(new ResetRequest(ResetKind.All, [], null, null, 0, "All Immich location names"));
    private Task<long> CountAsync(ResetRequest request) => Db.GetResetCountAsync(
        request.Kind == ResetKind.Assets ? request.Ids : null, request.Scope, request.Value);

    private async Task ReviewAsync(ResetRequest request)
    {
        if (_busy || State.IsRunning)
        {
            return;
        }
        _busy = true;
        _activity = "Counting assets for reset review…";
        _error = null;
        _result = null;
        try
        {
            _pending = request with { Count = await CountAsync(request) };
        }
        catch (Exception)
        {
            _error = "Could not count the affected assets. Check the database connection and retry the review. Nothing has been reset.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ConfirmResetAsync()
    {
        if (_busy || _pending is null || State.IsRunning)
        {
            return;
        }
        using var maintenance = Processor.TryBeginMaintenance();
        if (maintenance is null)
        {
            _error = "Processing or another maintenance action started. Wait for it to finish, then review the reset again.";
            return;
        }
        var request = _pending;
        _busy = true;
        _activity = "Resetting selected location names…";
        _error = null;
        var locationWriteCompleted = false;
        long cleared = 0;
        try
        {
            var currentCount = await CountAsync(request);
            if (currentCount != request.Count)
            {
                _pending = request with { Count = currentCount };
                _error = "The affected count changed since review. Check the updated count and confirm again. Nothing has been reset yet.";
                return;
            }
            if (State.IsRunning)
            {
                _error = "Processing started during review. Wait for it to finish before confirming.";
                return;
            }
            if (request.Kind == ResetKind.All)
            {
                cleared = await Db.ClearAllLocationDataAsync();
                locationWriteCompleted = true;
                await Skipped.ClearAllAsync();
                PreviewSession.ResetAll = true;
                PreviewSession.Review.Clear();
            }
            else
            {
                var clearedIds = request.Kind == ResetKind.Assets
                    ? await Db.ClearLocationDataForAssetsAsync(request.Ids)
                    : await Db.ClearLocationDataByValueAsync(request.Scope!.Value, request.Value!);
                cleared = clearedIds.Count;
                locationWriteCompleted = true;
                await Skipped.RemoveAsync(request.Kind == ResetKind.Assets ? request.Ids : clearedIds);
                PreviewSession.RemoveResetAssets(request.Kind == ResetKind.Assets ? request.Ids : clearedIds);
            }
            _pending = null;
            _result = $"Cleared location names for {cleared:N0} assets and updated the skip list. Run processing from the Dashboard to resolve location names again.";
            await LoadLocationOptionsAsync();
        }
        catch (Exception)
        {
            // PostgreSQL and SQLite are separate stores: report partial completion explicitly.
            _pending = null;
            _error = locationWriteCompleted
                ? $"Location names were cleared for {cleared:N0} assets, but the skip list could not be updated. Check Data and the database connection before reviewing a retry."
                : "Reset could not be confirmed. Check the database connection and review before retrying; a lost connection can leave the write outcome uncertain.";
        }
        finally
        {
            _busy = false;
        }
    }

    private enum ResetKind
    {
        Assets,
        Location,
        All
    }
    private sealed record ResetRequest(ResetKind Kind, Guid[] Ids, LocationResetScope? Scope, string? Value, long Count, string Description);
}

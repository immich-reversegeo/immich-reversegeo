@page "/data/location-preview"
@page "/data/location-management/scan"
@rendermode InteractiveServer
@inject LocationChangeRepository Changes
@inject LocationReviewResults Results
@using System.Linq
@using System.Threading
@using System.Diagnostics
@using Microsoft.Extensions.Logging
@inject ImmichDbRepository Db
@inject ConfigService Config
@inject AssetLocationResolverService Resolver
@inject ProcessingState State
@inject ILogger<LocationPreview> Logger
@inject SavedLocationPreviewRepository SavedPreviews
@inject LocationPreviewSession Session
@inject NavigationManager Navigation
@inject PreviewCircuitLifetime CircuitLifetime
@implements IDisposable

<PageTitle>@(ResumeScanId is null ? "Scan & Review" : "Continue Saved Scan") - Immich ReverseGeo</PageTitle>

<h2>@(ResumeScanId is null ? "Scan & Review" : "Continue Saved Scan")</h2>
<LocationManagementNav ActiveSection="scan" />
<p class="page-desc">@(ResumeScanId is null ? "Scan your library, review differences, then apply only the names you select." : "Continue with the saved selection and original settings. Previously checked results are kept.")</p>
@if (ResumeScanId is not null)
{
    <div class="btn-row">
        <a class="text-link" href="@($"/data/location-management/scans/{ResumeScanId}")">View saved results</a>
        <a class="text-link" href="/data/location-management/scan">Start a new scan</a>
    </div>
}

<section class="settings-card wide-card scan-setup">
    <h3>@(ResumeScanId is null ? "Scan setup" : "Original scan options")</h3>
    <details class="location-help" open="@(ResumeScanId is null)">
        <summary>@(ResumeScanId is null ? "Choose assets and scan options" : "View original options (read only)")</summary>
        @if (ResumeScanId is null)
        {
            <div class="scan-setup-grid">
                <div class="form-group">
                    <label for="preview-scope">Check assets by</label>
                    <select id="preview-scope" class="form-control" @bind="_scope" disabled="@(_busy || _applying || _reviewing || !_circuitReady || ResumeScanId is not null)">
                        <option value="@LocationPreviewScope.AssetIds">Asset GUIDs</option>
                        <option value="@LocationPreviewScope.City">Existing city</option>
                        <option value="@LocationPreviewScope.State">Existing state</option>
                        <option value="@LocationPreviewScope.Country">Existing country</option>
                        <option value="@LocationPreviewScope.All">Whole library</option>
                    </select>
                </div>
                @if (_scope != LocationPreviewScope.All)
                {
                    <div class="form-group scan-input">
                        <label for="preview-input">@(_scope == LocationPreviewScope.AssetIds ? "Asset GUIDs" : "Existing location name")</label>
                        <textarea id="preview-input" class="form-control reset-textarea" rows="3" @bind="_input" @bind:event="oninput" disabled="@(_busy || _applying || _reviewing || !_circuitReady || ResumeScanId is not null)"></textarea>
                        <span class="hint">@(_scope == LocationPreviewScope.AssetIds
                            ? "Paste up to 1,000 GUIDs, separated by commas, spaces, or new lines."
                            : "Enter the exact city, state, or country name stored in Immich. Assets with that value and both GPS coordinates are included.")</span>
                    </div>
                }
                <div class="form-group">
                    <label for="preview-order">Order by</label>
                    <select id="preview-order" class="form-control" @bind="_order" disabled="@(_busy || _applying || _reviewing || !_circuitReady || ResumeScanId is not null)">
                        <option value="@LocationPreviewOrder.AssetId">Asset GUID</option>
                        <option value="@LocationPreviewOrder.NearbyCoordinates">Nearby coordinates</option>
                    </select>

                </div>
                <div class="form-group">
                    <label for="preview-mode">Scan mode</label>
                    <select id="preview-mode" class="form-control" @bind="_scanMode" disabled="@(_busy || _applying || _reviewing || !_circuitReady || ResumeScanId is not null)">
                        <option value="@LocationPreviewScanMode.ManualPages">Manual pages</option>
                        <option value="@LocationPreviewScanMode.Continuous">Continuous scan</option>
                    </select>

                </div>
                @if (_scanMode == LocationPreviewScanMode.Continuous)
                {
                    <div class="form-group">
                        <label for="preview-limit">Pause after this many new differences</label>
                        <input id="preview-limit" class="form-control" type="number" min="0" @bind="_pauseAfterDifferences" @bind:event="oninput" disabled="@(_busy || _applying || _reviewing || !_circuitReady || ResumeScanId is not null)" />
                        <span class="hint">Use 0 to scan to the end. Continue Scan checks until the next group of differences is found.</span>
                    </div>
                }
            </div>
        }
        else if (_settings is not null)
        {
            <dl class="location-metadata">
                <div><dt>Selection</dt><dd>@SelectionLabel</dd></div>
                <div><dt>Order</dt><dd>@OrderLabel</dd></div>
                <div><dt>Scan mode</dt><dd>@(_scanMode == LocationPreviewScanMode.Continuous ? "Continuous" : "Manual pages")</dd></div>
                <div><dt>Pause after differences</dt><dd>@(_pauseAfterDifferences == 0 ? "No limit" : _pauseAfterDifferences.ToString("N0"))</dd></div>
                <div><dt>Airport names</dt><dd>@(_settings.UseAirportInfrastructure ? "Enabled" : "Disabled")</dd></div>
                <div><dt>GADM administrative areas</dt><dd>@(_settings.UseGadmAdministrativeAreas ? "Enabled (non-commercial)" : "Disabled")</dd></div>
                <div><dt>Preferred source</dt><dd>@(_settings.UseGadmAdministrativeAreas && _settings.PreferGadmAdministrativeAreas ? "GADM" : "Overture")</dd></div>
                <div><dt>Low-memory mode</dt><dd>@(_settings.LowMemoryMode ? "Enabled" : "Disabled")</dd></div>
            </dl>
        }
        else
        {
            <p>@(_circuitReady ? "Original scan options are unavailable. Check the error below." : "Loading original scan options…")</p>
        }
    </details>
    @if (ResumeScanId is null && _scanner is not null)
    {
        <div class="btn-row">
            <button class="btn btn-secondary" @onclick="StartAsync" disabled="@(_busy || _applying || _reviewing || !_circuitReady)">Start New Scan</button>
            <span class="hint">Starts a new snapshot and clears your selection.</span>
        </div>
    }
    <details class="location-help">
        <summary>Scan scope and cache downloads</summary>
        <p>Only active assets with a metadata row and both GPS coordinates are included. Scanning does not change Immich or the skip list.</p>
        <p>Nearby coordinates groups photos into map tiles for cache reuse; sorting large libraries can take longer. Continuous mode advances automatically and pauses after the chosen number of new differences.</p>
        <p>Keep this page open while scanning. Leaving or reloading stops it; completed results remain saved. Return in this browser session or continue from Saved Scans after a restart.</p>
        <p>Country preparation can take several minutes the first time. Progress counts checked assets, not downloads; cache preparation can change the time estimate.</p>
    </details>
</section>

<section class="settings-card wide-card scan-status @(!_busy && _pausedAfterDifferences is not null ? "scan-status-paused" : "")" aria-labelledby="scan-status-title">
    <div class="location-section-header">
        <h3 id="scan-status-title">Scan progress</h3>
        <span class="scan-state" role="status">@(_busy ? "Scanning" : _error is not null ? "Needs attention" : _pausedAfterDifferences is not null ? "Paused for review" : _hasMore ? "Ready to continue" : _scanner is not null ? "Scan complete" : "Ready to scan")</span>
    </div>
    <dl class="location-metadata scan-metrics">
        <div><dt>Checked</dt><dd>@((_estimate?.Checked ?? _scanner?.CheckedCount ?? 0).ToString("N0")) / @(_estimate?.Total.ToString("N0") ?? "—")</dd></div>
        <div><dt>Progress</dt><dd>@(_estimate is null ? "—" : $"{_estimate.Percentage:F1}%")</dd></div>
        <div><dt>Time remaining</dt><dd>@(_estimate is null ? "—" : RemainingLabel)</dd></div>
        <div><dt>Differences found</dt><dd>@((_scanner?.DifferentCount ?? 0).ToString("N0"))</dd></div>
    </dl>
    @if (_estimate is not null)
    {
        <progress value="@_estimate.Percentage" max="100" aria-label="Overall preview progress"></progress>
    }
    @if (_busy)
    {
        <p class="scan-activity" role="status">@(_stage.Length > 0 ? _stage : "Preparing scan…")</p>
        <details class="location-help">
            <summary>Current asset and batch details</summary>
            <p>@(_pageCount == 0 ? "Loading matching assets…" : $"Checking asset {Math.Min(_rows.Count + 1, _pageCount)} of {_pageCount}.") Page elapsed: @_pageElapsed.Elapsed.ToString(@"hh\:mm\:ss").</p>
            @if (_pageCount > 0)
            {
                <progress value="@_rows.Count" max="@_pageCount" aria-label="Assets checked on this page"></progress>
            }
            <p>Current step elapsed: @_stageElapsed.Elapsed.ToString(@"hh\:mm\:ss").</p>
            @if (_currentAssetId is not null)
            {
                <p>Current asset: <code>@_currentAssetId</code></p>
            }
        </details>
    }
    @if (!_busy && _pausedAfterDifferences is { } pausedCount)
    {
        <p class="preview-pause-status" role="status"><strong>Paused for review</strong> — @pausedCount.ToString("N0") new differences found. Review or apply them, then continue.</p>
    }
    else if (_message is not null)
    {
        <p role="status">@_message</p>
    }
    <div class="btn-row scan-primary-action">
        @if (_busy)
        {
            <button class="btn btn-secondary" @onclick="Cancel">Cancel Scan</button>
        }
        else if (ResumeScanId is not null)
        {
            <button class="btn btn-primary" @onclick="StartAsync" disabled="@(_applying || _reviewing || !_circuitReady || !_resumeLoaded || !_hasMore)">@(!_circuitReady ? "Loading saved scan…" : "Continue Saved Scan")</button>
        }
        else if (_scanner is null)
        {
            <button class="btn btn-primary" @onclick="StartAsync" disabled="@(_applying || _reviewing || !_circuitReady)">@(_circuitReady ? "Start Scan" : "Starting UI…")</button>
        }
        else if (_hasMore)
        {
            <button class="btn btn-primary" @onclick="NextAsync" disabled="@(_applying || _reviewing || !_circuitReady)">@ContinueLabel</button>
        }
        @if (_savedPreviewId is not null)
        {
            <a class="text-link" href="@($"/data/location-management/scans/{_savedPreviewId}")" target="_blank" rel="noopener">View saved results</a>
        }
    </div>
    @if (_settings?.UseGadmAdministrativeAreas == true)
    {
        <p class="hint">This scan uses GADM data, licensed for non-commercial use.</p>
    }
    <ImmichPhotoSetup ShowHelp="false" />
    @if (_saveError is not null)
    {
        <p class="alert alert-error" role="alert">@_saveError</p>
    }
    @if (_error is not null)
    {
        <p class="alert alert-error" role="alert">@_error</p>
    }
    <details class="location-help">
        <summary>Saved results, timing, and logs</summary>
        <p>Completed results are saved automatically. <a class="text-link" href="/data/location-management/scans" target="_blank" rel="noopener">View saved scans</a> after reloading or restarting.</p>
        <p>Your live review and selections are kept when you visit Lookup and return. Results use the settings saved at the start; start a new scan to use changed settings.</p>
        <p>Active scan time: @ActiveScanTime.ToString(@"hh\:mm\:ss"). The estimate excludes review pauses and appears after a small sample.</p>
        <p><a class="text-link" href="/logs" target="_blank" rel="noopener">Open Logs</a> for scan starts, download waits, failures, and batch summaries.</p>
    </details>
</section>

@if (_rows.Count > 0 || _review.Count > 0 || _hasMore || (_scanner?.CheckedCount ?? 0) > 0)
{
    <section class="settings-card wide-card">
        <div class="location-section-header"><h3 class="review-focus-target" tabindex="-1" @ref="_resultsHeading">Review results</h3><span class="hint">Page @_differences.Page · @_review.Count selected</span></div>
        <div hidden="@_reviewing">
            <p class="hint">Select changes across result pages, then review the entire selection. Handled changes leave Ready to apply; Differences found remains the original scan total.</p>
            <div class="review-filter-bar">
                <label><input type="checkbox" @bind="_onlyChanges" @bind:after="FilterDifferencesAsync" disabled="@(_busy || _applying)" /> Show only different values</label>

                <label for="live-result-filter">Show results</label>
                <select id="live-result-filter" class="form-control" @bind="_resultFilter" @bind:after="FilterDifferencesAsync" disabled="@(_busy || _applying)">
                    <option value="@LocationReviewFilter.Ready">Ready to apply</option>
                    <option value="@LocationReviewFilter.Applied">Applied</option>
                    <option value="@LocationReviewFilter.Attention">Needs attention</option>
                    <option value="@LocationReviewFilter.All">All results</option>
                </select>

            </div>
            @if (!VisibleRows.Any())
            {
                <p class="hint">No @(_resultFilter == LocationReviewFilter.Ready ? "differences ready to apply" : "results matching this filter") @(_busy ? "yet" : "among checked assets"). @(_hasMore ? $"Use {ContinueLabel} to check more assets." : "Choose All results to inspect saved snapshots.")</p>
            }
            @if (!_busy && !_applying && (VisibleRows.Any(CanSelect) || _review.Count > 0))
            {
                <div class="btn-row">
                    <button class="btn btn-secondary" @onclick="SelectPageChanges" disabled="@(!VisibleRows.Any(CanSelect))">Select Different Values on This Page</button>
                    <button class="btn btn-secondary" @onclick="_review.Clear" disabled="@(_review.Count == 0)">Clear Selection</button>
                </div>
            }
                <LocationReviewPagination Page="_differences.Page" HasNext="_differences.HasNext" Disabled="@(_busy || _applying)"
                    Label="Results" Previous="() => MoveDifferencesAsync(-1)" Next="() => MoveDifferencesAsync(1)" />
        </div>
        <div class="review-actions">
            @if (_savedPreviewId is not null)
            {
                <ApplyLocationChanges @ref="_applyReview" ReviewChanged="reviewing => _reviewing = reviewing" SelectionFocusRequested="RequestSelectionFocus" ScanId="_savedPreviewId" ReviewVersion="_reviewVersion" SelectedIds="_review.SelectedIds" Disabled="_busy"
                    BusyChanged="busy => _applying = busy" ResultsChanged="OnChangeResults" />
            }
        </div>
        <div hidden="@_reviewing">
            <div class="table-scroll" role="region" aria-label="Location comparisons; scroll horizontally to see all columns" tabindex="0">
                <table class="data-table location-comparison-table">
                    <thead><tr><th scope="col">Select</th><th scope="col">Photo</th><th scope="col">Asset GUID</th><th scope="col">Existing location</th><th scope="col">Proposed location</th><th scope="col">Result</th></tr></thead>
                    <tbody>
                        @foreach (var row in VisibleRows)
                        {
                            <tr @key="row.Asset.Id">
                                <td><input type="checkbox" aria-label="Select asset @row.Asset.Id"
                                           checked="@_review.IsSelected(row.Asset.Id)" disabled="@(_busy || _applying || !CanSelect(row))"
                                           @onchange="args => _review.Select(row, args.Value is true)" /></td>
                                <td><PreviewPhoto AssetId="row.Asset.Id" PreviewId="_savedPreviewId" LoadPreview="@row.HasChange" /></td>
                                <td><code>@row.Asset.Id</code>
                                    <div class="hint">GPS: @(row.Asset.Latitude?.ToString("G", System.Globalization.CultureInfo.InvariantCulture) ?? "—"), @(row.Asset.Longitude?.ToString("G", System.Globalization.CultureInfo.InvariantCulture) ?? "—")</div>
                                    <a class="text-link" href="@LookupUrl(row.Asset)">Inspect in Lookup</a>
                                </td>
                                <td>
                                    <div>City: <LocationDiffValue Value="@row.Asset.Existing.City" OtherValue="@row.Proposed?.City" Highlight="@row.HasChange" /></div>
                                    <div>State: <LocationDiffValue Value="@row.Asset.Existing.State" OtherValue="@row.Proposed?.State" Highlight="@row.HasChange" /></div>
                                    <div>Country: <LocationDiffValue Value="@row.Asset.Existing.Country" OtherValue="@row.Proposed?.Country" Highlight="@row.HasChange" /></div>
                                </td>
                                <td>
                                    <div>City: <LocationDiffValue Value="@row.Proposed?.City" OtherValue="@row.Asset.Existing.City" Highlight="@row.HasChange" /></div>
                                    <div>State: <LocationDiffValue Value="@row.Proposed?.State" OtherValue="@row.Asset.Existing.State" Highlight="@row.HasChange" /></div>
                                    <div>Country: <LocationDiffValue Value="@row.Proposed?.Country" OtherValue="@row.Asset.Existing.Country" Highlight="@row.HasChange" /></div>
                                </td>
                                <td>@(Session.ResetAll || Session.ResetAssets.Contains(row.Asset.Id) ? "Reset — run processing or start a fresh scan" : _changeResults.TryGetValue(row.Asset.Id, out var outcome) ? outcome.Label : row.Status)
                                    @if (_changeResults.TryGetValue(row.Asset.Id, out var change))
                                    {
                                        <div class="hint">@change.Message</div>
                                        <a class="text-link" href="@($"/data/location-management/history/{change.OperationId}")">View change</a>
                                    }
                                    @if (row.Error is not null)
                                    {
                                        <div>@row.Error</div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (_savedPreviewId is not null)
            {
                <p class="hint">Showing saved results from all checked batches. Applying changes refreshes this page and removes handled rows from Ready to apply.</p>
                <LocationReviewPagination Page="_differences.Page" HasNext="_differences.HasNext" Disabled="@(_busy || _applying)"
                    Label="Results" Previous="() => MoveDifferencesAsync(-1)" Next="() => MoveDifferencesAsync(1)" />
            }
            @if (_differenceError is not null)
            {
                <p class="alert alert-error" role="alert">@_differenceError</p>
            }
            @if (!_busy && !_applying && _review.Count > 0)
            {
                <details class="location-help">
                    <summary>Selected GUIDs and optional reset workflow (@_review.Count)</summary>
                    <div class="form-group">
                        <label for="preview-changed-ids">Selected GUIDs from reviewed pages (@_review.Count)</label>
                        <textarea id="preview-changed-ids" class="form-control reset-textarea" readonly
                                  value="@string.Join(Environment.NewLine, _review.SelectedIds)"></textarea>
                    </div>
                    <p>Apply the reviewed values above, or use the optional reset and reprocessing workflow.</p>
                    <button class="btn btn-secondary" @onclick="ReviewReset">Review Reset for @_review.Count Selected Assets</button>
                </details>
            }

            <LocationReviewHelp />
            @if (_review.Count > 0 && !_reviewing)
            {
                <LocationSelectionBar @ref="_selectionBar" Count="_review.Count" Disabled="@(_busy || _applying)"
                    Clear="ClearFromSelectionBar" Review="ReviewFromSelectionBarAsync" />
            }
        </div>
    </section>
}

@code {
    private ApplyLocationChanges? _applyReview;
    private LocationSelectionBar? _selectionBar;
    private bool _reviewing;
    private long _reviewVersion;
    private bool _focusResults;
    private ElementReference _resultsHeading;
    private bool _focusSelectionBar;

    private Task ReviewFromSelectionBarAsync() => _applyReview?.ReviewFromSelectionAsync() ?? Task.CompletedTask;
    private void RequestSelectionFocus() => _focusSelectionBar = true;
    private void ClearFromSelectionBar()
    {
        _review.Clear();
        RequestSelectionFocus();
    }
    private async Task FocusSelectionBarAsync()
    {
        if (_focusResults && !_busy && !_applying)
        {
            _focusResults = false;
            await _resultsHeading.FocusAsync();
        }
        if (!_focusSelectionBar || _busy || _applying)
        {
            return;
        }
        _focusSelectionBar = false;
        if (_review.Count > 0 && !_reviewing && _selectionBar is not null)
        {
            await _selectionBar.FocusReviewAsync();
        }
        else if (_applyReview is not null)
        {
            await _applyReview.FocusSelectionAsync();
        }
    }

    [Parameter] public Guid? ResumeScanId { get; set; }
    private bool _resumeLoaded;
    private Guid? _scanRunToken;
    private TimeSpan _elapsedBeforeResume;
    private TimeSpan ActiveScanTime => _elapsedBeforeResume + _scanElapsed.Elapsed;
    private LocationPreviewCheckpoint Checkpoint => new(_estimate?.Total, ActiveScanTime.Ticks, _page, _pausedAfterDifferences);
    private LocationPreviewScope _scope = LocationPreviewScope.AssetIds;
    private string? _input;
    private bool _busy;
    private bool _circuitReady;
    private bool _applying;
    private Dictionary<Guid, LocationChangeItem> _changeResults = new();
    private bool _onlyChanges = true;
    private LocationReviewFilter _resultFilter = LocationReviewFilter.Ready;
    private LocationPreviewDifferencePage _differences = new();
    private string? _differenceError;
    private IEnumerable<LocationPreviewRow> VisibleRows => _differences.Rows;
    private bool CanSelect(LocationPreviewRow row) => row.HasChange && !_changeResults.ContainsKey(row.Asset.Id) && !Session.ResetAll && !Session.ResetAssets.Contains(row.Asset.Id);
    private LocationPreviewOrder _order = LocationPreviewOrder.AssetId;
    private bool _hasMore => _scanner?.HasMore ?? false;
    private bool _disposed;
    private int _page => _scanner?.BatchNumber ?? 0;
    private int _pageCount => _scanner?.BatchSize ?? 0;
    private string? _message;
    private long? _pausedAfterDifferences;
    private string? _error;
    private string? _saveError;
    private Guid? _savedPreviewId;
    private LocationPreviewScanner? _scanner;
    private LocationPreviewScanMode _scanMode;
    private int _pauseAfterDifferences = 100;
    private int _observedBatch;
    private string ContinueLabel => _selection?.ScanMode == LocationPreviewScanMode.Continuous ? "Continue Scan" : "Scan Next 100";
    private Stopwatch _scanElapsed => Session.ScanElapsed;
    private LocationPreviewScanEstimate? _estimate;
    private LocationPreviewSelection? _selection;
    private ProcessingConfig? _settings;
    private CancellationTokenSource? _cts;
    private string _previewId = string.Empty;
    private string _stage = string.Empty;
    private Guid? _currentAssetId;
    private readonly Stopwatch _pageElapsed = new();
    private readonly Stopwatch _stageElapsed = new();
    private IReadOnlyList<LocationPreviewRow> _rows => _scanner?.Rows ?? Array.Empty<LocationPreviewRow>();
    private LocationPreviewReview _review => Session.Review;
    private bool _restored;

    private string RemainingLabel => _estimate?.EstimatedRemaining is not { } remaining
        ? "Estimating…"
        : remaining.TotalDays >= 1 ? $"about {remaining.TotalDays:F1} days"
        : remaining.TotalHours >= 1 ? $"about {remaining.TotalHours:F1} hours"
        : remaining.TotalMinutes >= 1 ? $"about {Math.Ceiling(remaining.TotalMinutes):N0} minutes"
        : $"about {Math.Ceiling(remaining.TotalSeconds):N0} seconds";

    private async Task FilterDifferencesAsync()
    {
        _reviewVersion++;
        _differences = new LocationPreviewDifferencePage();
        await RefreshDifferencesAsync(force: true);
        await LoadChangeResultsAsync();
    }

    private async Task RefreshDifferencesAsync(bool force = false)
    {
        if (_savedPreviewId is not { } id)
        {
            return;
        }

        try
        {
            await _differences.RefreshAsync(_scanner?.CheckedCount ?? 0,
                page => Results.GetRowsAsync(id, page, _resultFilter, _onlyChanges), force);
            _differenceError = null;
        }
        catch (Exception ex)
        {
            _differenceError = $"Could not load review results: {ex.Message}. Completed results remain saved.";
        }
    }

    private async Task MoveDifferencesAsync(int direction)
    {
        if (_busy || _applying || _savedPreviewId is not { } id)
        {
            return;
        }

        try
        {
            _reviewVersion++;
            await _differences.MoveAsync(direction, _scanner?.CheckedCount ?? 0,
                page => Results.GetRowsAsync(id, page, _resultFilter, _onlyChanges));
            await LoadChangeResultsAsync();
            _focusResults = true;
            _differenceError = null;
        }
        catch (Exception ex)
        {
            _differenceError = $"Could not load review results: {ex.Message}. Completed results remain saved.";
        }
    }

    private async Task OnChangeResults(IReadOnlyList<LocationChangeItem> items)
    {
        _review.Clear();
        _reviewVersion++;
        _differences = new LocationPreviewDifferencePage();
        _resultFilter = LocationReviewFilter.Ready;
        _onlyChanges = true;
        await RefreshDifferencesAsync(force: true);
        await LoadChangeResultsAsync();
    }

    private async Task LoadChangeResultsAsync()
    {
        if (_savedPreviewId is not { } id) { return; }
        _changeResults = new Dictionary<Guid, LocationChangeItem>(
            await Changes.GetScanResultsAsync(id, VisibleRows.Take(100).Select(row => row.Asset.Id).ToArray()));
    }
    private void SelectPageChanges()
    {
        foreach (var row in VisibleRows.Where(CanSelect))
        {
            _review.Select(row, true);
        }
    }

    private string SelectionLabel => _selection?.Scope switch
    {
        LocationPreviewScope.AssetIds => $"{_selection.AssetIds.Length} asset GUID(s)",
        LocationPreviewScope.All => "Whole library (GPS only)",
        LocationPreviewScope.City => $"Existing city: {_selection.Value}",
        LocationPreviewScope.State => $"Existing state: {_selection.Value}",
        LocationPreviewScope.Country => $"Existing country: {_selection.Value}",
        _ => string.Empty
    };

    private string PageSummary => $"Unchanged: {_rows.Count(row => row.Status == "Unchanged")}; "
        + $"unresolved: {_rows.Count(row => row.Status == "No resolvable location")}; "
        + $"failed: {_rows.Count(row => row.Error is not null)}.";

    private string OrderLabel => _selection?.Order == LocationPreviewOrder.NearbyCoordinates ? "Nearby coordinates" : "Asset GUID";

    private static string LookupUrl(LocationPreviewAsset asset) => FormattableString.Invariant($"/lookup?lat={asset.Latitude}&lon={asset.Longitude}");

    private void ReviewReset()
    {
        Session.PrepareReset();
        SaveSession();
        Navigation.NavigateTo("/data/reset-geo-data");
    }

    private void SaveSession()
    {
        if (!_restored)
        {
            return;
        }
        Session.Scope = _scope;
        Session.Input = _input;
        Session.Order = _order;
        Session.Mode = _scanMode;
        Session.PauseAfterDifferences = _pauseAfterDifferences;
        Session.Selection = _selection;
        Session.Settings = _settings;
        Session.Scanner = _scanner;
        Session.Estimate = _estimate;
        Session.SavedPreviewId = _savedPreviewId;
        Session.PreviewLogId = _previewId;
        Session.Differences = _differences;
        Session.Filter = _resultFilter;
        Session.OnlyChanges = _onlyChanges;
        Session.ResumeScanId = ResumeScanId;
        Session.ElapsedBeforeResume = _elapsedBeforeResume;
        Session.PausedDifferences = _pausedAfterDifferences;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await FocusSelectionBarAsync();
        if (!firstRender)
        {
            return;
        }
        // Let the prior component finish cancellation and saving before taking over its scanner.
        if (Session.RunningScan is { } previous)
        {
            try
            {
                await previous;
            }
            catch (Exception ex)
            {
                _error = $"The previous scan was interrupted: {ex.Message}. Completed results remain in Saved Scans.";
            }
        }
        if (_disposed)
        {
            return;
        }
        if (ResumeScanId is { } resumeId)
        {
            try
            {
                var saved = await SavedPreviews.GetResumeStateAsync(resumeId);
                if (!saved.Report.CanResume)
                {
                    throw new InvalidOperationException("This scan is running or complete. Open its saved results to check the current status.");
                }
                RestoreSavedScan(saved);
                _savedPreviewId = resumeId;
                _previewId = resumeId.ToString("N")[..8];
                _resumeLoaded = true;
                _pausedAfterDifferences = saved.Report.Status == "Paused"
                    ? saved.Report.Checkpoint?.PausedDifferences ?? saved.Report.Selection.PauseAfterDifferences : null;
                _message = $"Saved status: {saved.Report.StatusLabel}. Continue after the last saved asset.";
                if (Session.ResumeScanId == resumeId && Session.SavedPreviewId == resumeId)
                {
                    _differences = Session.Differences;
                    _resultFilter = Session.Filter;
                    _onlyChanges = Session.OnlyChanges;
                }
                else
                {
                    _review.Clear();
                    Session.ResetAssets.Clear();
                    Session.ResetAll = false;
                }
            }
            catch (Exception ex)
            {
                _error = "Could not load saved scan for continuation: " + ex.Message;
            }
        }
        else if (Session.ResumeScanId is null)
        {
            _scope = Session.Scope;
            _input = Session.Input;
            _order = Session.Order;
            _scanMode = Session.Mode;
            _pauseAfterDifferences = Session.PauseAfterDifferences;
            _selection = Session.Selection;
            _settings = Session.Settings;
            _scanner = Session.Scanner;
            _estimate = Session.Estimate;
            _savedPreviewId = Session.SavedPreviewId;
            _previewId = Session.PreviewLogId;
            _differences = Session.Differences;
            _resultFilter = Session.Filter;
            _onlyChanges = Session.OnlyChanges;
            _observedBatch = _page;
            _elapsedBeforeResume = Session.ElapsedBeforeResume;
            _pausedAfterDifferences = Session.PausedDifferences;
        }
        else
        {
            // The new-scan page must not silently reuse the frozen continuation options.
            _review.Clear();
            Session.ResetAssets.Clear();
            Session.ResetAll = false;
            _scanElapsed.Reset();
        }
        _restored = true;
        if (_savedPreviewId is { } id)
        {
            try
            {
                await RefreshDifferencesAsync(force: true);
                await LoadChangeResultsAsync();
                if (_review.Count > 0)
                {
                    var handled = await Changes.GetScanResultsAsync(id, _review.SelectedIds);
                    foreach (var assetId in handled.Keys)
                    {
                        _review.Deselect(assetId);
                    }
                }
            }
            catch (Exception ex)
            {
                _differenceError = $"Could not restore the review: {ex.Message}. Completed results remain in Saved Scans.";
            }
        }
        CircuitLifetime.Disconnected += Cancel;
        _circuitReady = true;
        StateHasChanged();
    }

    private void RestoreSavedScan(LocationPreviewResumeState saved)
    {
        _selection = saved.Report.Selection;
        _settings = saved.Report.Settings;
        _scope = _selection.Scope;
        _input = _scope == LocationPreviewScope.AssetIds ? string.Join(Environment.NewLine, _selection.AssetIds) : _selection.Value;
        _order = _selection.Order;
        _scanMode = _selection.ScanMode;
        _pauseAfterDifferences = _selection.PauseAfterDifferences;
        _scanner = LocationPreviewScanner.FromSaved(saved);
        _elapsedBeforeResume = TimeSpan.FromTicks(Math.Max(0, saved.Report.Checkpoint?.ActiveTicks ?? 0));
        _scanElapsed.Reset();
        _estimate = saved.Report.Checkpoint?.TotalCount is { } total
            ? new LocationPreviewScanEstimate(total, saved.Report.CheckedCount, ActiveScanTime) : null;
    }

    private async Task StartAsync()
    {
        if (_busy || _applying)
        {
            return;
        }

        _error = null;
        if (ResumeScanId is not null)
        {
            if (_resumeLoaded)
            {
                await PreviewPageAsync(reloadSettings: false);
            }
            return;
        }
        LocationPreviewSelection selection;
        try
        {
            selection = LocationPreviewSelection.Create(_scope, _input) with
            {
                Order = _order,
                ScanMode = _scanMode,
                PauseAfterDifferences = _scanMode == LocationPreviewScanMode.Continuous ? _pauseAfterDifferences : 0
            };
            _ = new LocationPreviewScanner(selection.ScanMode, selection.PauseAfterDifferences);
        }
        catch (ArgumentException ex)
        {
            _error = ex.Message;
            return;
        }

        _selection = selection;
        _message = null;
        _pausedAfterDifferences = null;
        _scanner = new LocationPreviewScanner(selection.ScanMode, selection.PauseAfterDifferences);
        _reviewing = false;
        _resultFilter = LocationReviewFilter.Ready;
        _onlyChanges = true;
        _review.Clear();
        Session.ResetAssets.Clear();
        Session.ResetAll = false;
        _differences = new LocationPreviewDifferencePage();
        _differenceError = null;
        _changeResults.Clear();
        _observedBatch = 0;
        _scanElapsed.Reset();
        _elapsedBeforeResume = TimeSpan.Zero;
        _estimate = null;
        _savedPreviewId = null;
        _saveError = null;
        _previewId = Guid.NewGuid().ToString("N")[..8];
        LogPreview($"Started: {SelectionLabel}. Order: {OrderLabel}. Immich data will not be changed.");
        await PreviewPageAsync(reloadSettings: true);
    }

    private Task NextAsync() => PreviewPageAsync(reloadSettings: false);

    private Task PreviewPageAsync(bool reloadSettings)
    {
        if (_busy || _applying || _reviewing || !_circuitReady)
        {
            return Task.CompletedTask;
        }
        var scan = PreviewPageCoreAsync(reloadSettings);
        Session.RunningScan = scan;
        return scan;
    }

    private async Task PreviewPageCoreAsync(bool reloadSettings)
    {
        if (_busy || _applying || _selection is null || _disposed)
        {
            return;
        }

        _busy = true;
        _message = null;
        _pausedAfterDifferences = null;
        _error = null;
        _cts?.Dispose();
        _cts = new CancellationTokenSource();
        var ct = _cts.Token;
        var pageCts = _cts;
        _currentAssetId = null;
        _pageElapsed.Restart();
        SetStage("Loading matching assets…");
        var refreshTask = RefreshElapsedAsync(ct);
        var progress = new LocationPreviewProgress(
            message => UpdateProgress(pageCts, () => SetStage(message)),
            message => LogPreview(message));
        var savedStatus = "Failed";
        try
        {
            if (reloadSettings)
            {
                _settings = (await Config.GetConfigAsync()).Processing;
                var owner = Guid.NewGuid();
                _savedPreviewId = await SavedPreviews.CreateAsync(_selection, _settings, ct, runToken: owner);
                _scanRunToken = owner;
                LogPreview($"Saving results to report {_savedPreviewId}.");
            }
            else if (_savedPreviewId is not null)
            {
                var owner = Guid.NewGuid();
                var saved = await SavedPreviews.ClaimResumeAsync(_savedPreviewId.Value, owner, ct);
                _scanRunToken = owner;
                RestoreSavedScan(saved);
            }

            if (_estimate is null)
            {
                SetStage("Counting matching assets…");
                var checkedCount = _scanner?.CheckedCount ?? 0;
                var remaining = await Db.GetLocationPreviewCountAsync(_selection, ct, after: _scanner?.Cursor);
                _estimate = new LocationPreviewScanEstimate(checkedCount + remaining, checkedCount, ActiveScanTime);
                await InvokeAsync(StateHasChanged);
            }
            _scanElapsed.Start();
            ct.ThrowIfCancellationRequested();
            var outcome = await _scanner!.RunAsync(
                async (cursor, token) =>
                {
                    var assets = await SavedPreviews.LoadUnseenBatchAsync(_savedPreviewId!.Value, cursor,
                        (after, cancellation) => Db.GetLocationPreviewBatchAsync(_selection, after, cancellation), token);
                    LogPreview($"Page {_page}: checking {Math.Min(assets.Count, 100)} matching assets.");
                    return assets;
                },
                async (asset, token) =>
                {
                    _currentAssetId = asset.Id;
                    SetStage("Resolving location…");
                    await InvokeAsync(StateHasChanged);
                    try
                    {
                        // Keep synchronous cached lookups off the circuit dispatcher.
                        var proposed = await Task.Run(() => Resolver.ResolveAsync(
                            asset.Latitude!.Value, asset.Longitude!.Value, _settings!, progress, token), token);
                        token.ThrowIfCancellationRequested();
                        return new LocationPreviewRow(asset, proposed);
                    }
                    catch (OperationCanceledException) when (token.IsCancellationRequested)
                    {
                        throw;
                    }
                    catch (Exception ex)
                    {
                        LogPreview($"[ERROR] Asset {asset.Id}: {ex.Message}");
                        return new LocationPreviewRow(asset, null, ex.Message);
                    }
                },
                async row =>
                {
                    try
                    {
                        await SavedPreviews.AppendAsync(_savedPreviewId!.Value, row, runToken: _scanRunToken, checkpoint: Checkpoint);
                        _estimate.RecordChecked(ActiveScanTime);
                    }
                    catch (Exception ex)
                    {
                        throw new InvalidOperationException($"Could not save the latest preview result: {ex.Message}", ex);
                    }
                },
                async () =>
                {
                    if (_observedBatch != _page)
                    {
                        _observedBatch = _page;
                        _pageElapsed.Restart();
                        _currentAssetId = null;
                        SetStage("Loading matching assets…");
                    }
                    if (!_disposed)
                    {
                        await RefreshDifferencesAsync();
                        await InvokeAsync(StateHasChanged);
                    }
                }, ct);

            await RefreshDifferencesAsync(force: true);
            await LoadChangeResultsAsync();
            _pausedAfterDifferences = outcome.Paused ? outcome.NewDifferences : null;
            savedStatus = outcome.Paused ? "Paused" : _hasMore ? "More assets available" : "Complete";
            _message = outcome.Paused
                ? $"Paused after {outcome.NewDifferences} new differences. Review the saved results, then Continue Scan."
                : _scanner.CheckedCount == 0
                    ? "No matching active assets with both GPS coordinates found."
                    : _hasMore ? "Page complete. More matching assets are available." : "Scan complete. No more matching assets.";
            LogPreview($"{savedStatus}: {_scanner.CheckedCount} checked in total; {_scanner.DifferentCount} different. {_message}");
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            savedStatus = "Cancelled";
            _message = _hasMore
                ? $"Scan cancelled. Completed results are saved. Use {ContinueLabel} to continue after the last checked asset."
                : "Scan cancelled. Completed results are saved.";
            LogPreview($"Cancelled: {_scanner?.CheckedCount ?? 0} checked in total.");
        }
        catch (Exception ex)
        {
            _error = $"Scan failed: {ex.Message}";
            LogPreview($"[ERROR] {_error}");
        }
        finally
        {
            if (_savedPreviewId is not null && _scanRunToken is { } owner)
            {
                try
                {
                    await SavedPreviews.FinishRunAsync(_savedPreviewId.Value, owner, savedStatus, _error, Checkpoint);
                }
                catch (Exception ex)
                {
                    _saveError = $"Could not save preview status: {ex.Message}. Previously saved results are kept.";
                    LogPreview($"[ERROR] {_saveError}");
                }
            }
            _scanRunToken = null;
            _currentAssetId = null;
            _scanElapsed.Stop();
            _estimate?.UpdateElapsed(ActiveScanTime);
            _pageElapsed.Stop();
            _stageElapsed.Stop();
            pageCts.Cancel();
            await refreshTask;
            pageCts.Dispose();
            _cts = null;
            _busy = false;
            SaveSession();
        }
    }

    private void SetStage(string message)
    {
        _stage = message;
        _stageElapsed.Restart();
    }

    private void UpdateProgress(CancellationTokenSource pageCts, Action update)
    {
        if (_disposed)
        {
            return;
        }

        _ = InvokeAsync(() =>
        {
            if (!_disposed && _busy && ReferenceEquals(_cts, pageCts))
            {
                update();
                StateHasChanged();
            }
        });
    }

    private void LogPreview(string message)
    {
        var line = $"[Preview {_previewId}] {message}";
        State.AppendLog(line);
        if (message.Contains("[ERROR]", StringComparison.Ordinal))
        {
            Logger.LogError("{PreviewEvent}", line);
        }
        else if (message.Contains("[WARN]", StringComparison.Ordinal))
        {
            Logger.LogWarning("{PreviewEvent}", line);
        }
        else
        {
            Logger.LogInformation("{PreviewEvent}", line);
        }
    }

    private async Task RefreshElapsedAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                if (_disposed)
                {
                    return;
                }
                _estimate?.UpdateElapsed(ActiveScanTime);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
        }
    }

    private void Cancel() => _cts?.Cancel();

    public void Dispose()
    {
        SaveSession();
        CircuitLifetime.Disconnected -= Cancel;
        _disposed = true;
        _cts?.Cancel();
        if (!_busy)
        {
            _cts?.Dispose();
        }
    }
}

@page "/"
@rendermode InteractiveServer
@inject ProcessingState State
@inject ProcessingBackgroundService Processor
@inject ImmichDbRepository Db
@inject SkippedAssetsRepository Skipped
@implements IDisposable

<PageTitle>Dashboard - Immich ReverseGeo</PageTitle>

<h2>Dashboard</h2>
@if (State.IsMaintaining)
{
    <p class="alert alert-info" role="status">Maintenance is in progress. You can start processing when it finishes.</p>
}

<div class="settings-card">
    <h3>Which photos will be processed?</h3>
    <p>Runs process assets with GPS coordinates only when both city and country are missing.
        Existing location names are kept, even when they are incorrect. Previously skipped assets are excluded until you clear the skip list under Data.</p>
    <p>To correct existing names, <a class="text-link" href="/data/location-preview">preview location corrections</a>,
        then use <a class="text-link" href="/data/reset-geo-data">Reset Immich Geo Data</a> for the assets you want to reprocess.</p>
</div>

@if (!_circuitReady)
{
    <div class="alert alert-info">Starting the interactive UI…</div>
}
else if (_loadingStats)
{
    <div class="alert alert-info">Checking the Immich database connection and loading dashboard statistics…</div>
}
else if (_dbError is not null)
{
    <div class="settings-card">
        <h3>Database Connection Needed</h3>
        <p class="section-intro">
            The dashboard could not load Immich statistics yet because the database is currently unavailable.
        </p>
        <div class="alert alert-error">Database unavailable: @_dbError</div>
        <p class="section-intro">
            Check the database environment variables on the Settings page and make sure the app can reach the same PostgreSQL instance that Immich uses.
        </p>
        <div class="btn-row">
            <button @onclick="RefreshStats" class="btn btn-secondary">Retry Connection</button>
            <a href="/settings" class="btn btn-primary">Open Settings</a>
        </div>
    </div>
}

<div class="stats-row">
    <div class="stat-card">
        <div class="stat-value">@(!_circuitReady || _loadingStats || _dbError is not null ? "—" : UnprocessedDisplay.ToString("N0"))</div>
        <div class="stat-label">Missing Location Names</div>
    </div>
    <div class="stat-card">
        <div class="stat-value">@State.ProcessedThisRun</div>
        <div class="stat-label">Updated This Run</div>
    </div>
    <div class="stat-card">
        <div class="stat-value">@(!_circuitReady || _loadingStats || _dbError is not null ? "—" : SkippedDisplay.ToString("N0"))</div>
        <div class="stat-label">On the Skip List</div>
    </div>
    <div class="stat-card @(State.ErrorsThisRun > 0 ? "has-errors" : "")">
        <div class="stat-value">@State.ErrorsThisRun</div>
        <div class="stat-label">Errors</div>
    </div>
</div>

@{
    var pct = (State.IsRunning && State.TotalUnprocessed > 0)
        ? (int)Math.Min(100, State.CheckedThisRun * 100.0 / State.TotalUnprocessed)
        : 0;
}
<div class="progress-bar-wrap" role="progressbar" aria-label="Assets checked" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@pct" style="visibility:@(State.IsRunning && State.TotalUnprocessed > 0 ? "visible" : "hidden")">
    <div class="progress-bar" style="width:@pct%"></div>
</div>
<p class="run-info" style="visibility:@(State.IsRunning && State.TotalUnprocessed > 0 ? "visible" : "hidden")">
    @pct% — @State.CheckedThisRun.ToString("N0") / @State.TotalUnprocessed.ToString("N0") assets checked
</p>
<p class="run-info activity" role="status">@(State.CurrentActivity is not null ? $"⏳ {State.CurrentActivity}" : "\u00a0")</p>
@if (State.IsRunning || State.LastOutcome is not null)
{
    <div class="alert @(State.LastOutcome is ProcessingRunOutcome.Failed ? "alert-error" : "alert-info")" role="status">
        <strong>@OutcomeLabel</strong>
        <span>Checked: @State.CheckedThisRun.ToString("N0") · Updated: @State.ProcessedThisRun.ToString("N0") · Skipped this pass: @State.SkippedThisRun.ToString("N0") · Already on skip list: @State.PreviouslySkippedThisRun.ToString("N0") · Errors: @State.ErrorsThisRun.ToString("N0")</span>
        @if (State.LastError is not null)
        {
            <p>@State.LastError <a class="text-link" href="/logs">Inspect recent logs</a></p>
        }
    </div>
}

<div class="btn-row">
    <button @onclick="RunNow" disabled="@(!_circuitReady || _loadingStats || State.IsRunning || State.IsMaintaining || _runPending || _dbError is not null)" class="btn btn-primary">
        @(!_circuitReady ? "Starting UI…" : _loadingStats ? "Checking DB…" : State.IsRunning ? "Running…" : State.IsMaintaining ? "Maintenance Active…" : _runPending ? "Starting…" : "Run Now")
    </button>
    <button @onclick="() => Processor.CancelRun()" class="btn btn-secondary"
            style="visibility:@(State.IsRunning ? "visible" : "hidden")">Cancel</button>
    <button @onclick="RefreshStats" disabled="@(!_circuitReady || _loadingStats)" class="btn btn-secondary">
        @(_loadingStats ? "Refreshing…" : "Refresh Stats")
    </button>
    @if (State.LastRunCompleted.HasValue)
    {
        <span class="run-info">Last run ended: <LocalTimestamp Timestamp="@(new DateTimeOffset(State.LastRunCompleted.Value))" /></span>
    }
</div>

<h3>Recent Activity</h3>
<p class="run-info">Times are shown in your browser's timezone.</p>
<div class="log-tail">
    @foreach (var entry in State.GetRecentLogEntries().TakeLast(50).Reverse())
    {
        <div class="log-line @(entry.Message.Contains("[ERROR]") ? "error" : "")">[<LocalTimestamp Timestamp="entry.Timestamp" />] @entry.Message</div>
    }
</div>

@code {
    private string OutcomeLabel => State.IsRunning ? "Processing…" : State.LastOutcome switch
    {
        ProcessingRunOutcome.Cancelled => "Cancelled — completed updates are kept.",
        ProcessingRunOutcome.Failed => "Failed — check the error before retrying.",
        ProcessingRunOutcome.CompletedWithErrors => "Completed with errors — some assets need attention.",
        _ => "Completed"
    };
    private long _unprocessedCount;
    private long _totalSkipped;
    private bool _wasRunning;

    // Live: decrease as assets are processed/skipped during a run
    private long UnprocessedDisplay =>
        State.IsRunning
            ? Math.Max(0, _unprocessedCount - State.ProcessedThisRun)
            : _unprocessedCount;

    // Persistent total from file, plus newly skipped in the current run
    private long SkippedDisplay =>
        _totalSkipped;

    private string? _dbError;
    private bool _runPending;
    private bool _circuitReady;
    private bool _loadingStats;

    protected override Task OnInitializedAsync()
    {
        State.OnChanged += OnStateChanged;
        _wasRunning = State.IsRunning;
        // No DB calls here — Npgsql connect timeout (15 s) would block SSR and delay
        // the browser receiving the page, keeping the button stuck before the
        // interactive circuit is established.
        // OnAfterRenderAsync fires on the interactive path and kicks off stats loading.
        return Task.CompletedTask;
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_circuitReady)
        {
            _circuitReady = true;
            // Start stats load in background — button becomes clickable immediately,
            // counts update shortly after without blocking interactivity.
            _ = LoadStatsAsync().ContinueWith(_ => InvokeAsync(StateHasChanged));
            StateHasChanged();
        }
        return Task.CompletedTask;
    }

    private async Task LoadStatsAsync()
    {
        _loadingStats = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            _unprocessedCount = await Db.GetUnprocessedCountAsync();
            _totalSkipped = await Skipped.GetCountAsync();
            _dbError = null;
        }
        catch (Exception ex)
        {
            _dbError = ex.Message;
        }
        finally
        {
            _loadingStats = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RunNow()
    {
        _runPending = true;
        StateHasChanged();
        await LoadStatsAsync();
        _runPending = false;
        if (_dbError is null)
        {
            await Processor.TriggerRunAsync();
        }
    }

    private async Task RefreshStats()
    {
        await LoadStatsAsync();
    }

    private void OnStateChanged()
    {
        InvokeAsync(async () =>
        {
            // Reload DB stats when a run finishes
            if (!State.IsRunning && _wasRunning)
            {
                await LoadStatsAsync();
            }
            _wasRunning = State.IsRunning;
            StateHasChanged();
        });
    }

    public void Dispose() => State.OnChanged -= OnStateChanged;
}

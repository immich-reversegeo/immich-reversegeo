@page "/data/geoboundaries"
@rendermode InteractiveServer
@inject GadmDivisionCacheService GadmCache
@inject OvertureDivisionCacheService OvertureCache
@inject CountryCodeService CountryCodes
@inject ProcessingState State
@inject ProcessingBackgroundService Processor
@implements IDisposable

<PageTitle>Country Caches - Immich ReverseGeo</PageTitle>

<h2>Country Caches</h2>

@if (_result is not null)
{
    <div class="alert alert-success" role="status">@_result</div>
}
@if (_error is not null)
{
    <div class="alert alert-error" role="alert">@_error</div>
}
@if (_busy)
{
    <p role="status">@_activity The first download can take several minutes.</p>
}
@if (State.IsRunning)
{
    <p class="alert alert-info">Cache maintenance is unavailable during processing. Wait for the run to finish before changing caches.</p>
}

<div class="administrative-cache-page">
<section class="settings-card wide-card">
    <h3>Administrative Area Caches</h3>
    <p class="section-intro">Downloaded Overture and optional GADM administrative caches are reused for processing and lookup. Inspect one source or search by country name or code.</p>
    <div class="cache-filters">
        <div class="input-group">
            <label for="cache-source-filter">Source</label>
            <select id="cache-source-filter" @bind="_selectedSourceFilter">
                <option value="@CacheSourceFilter.All">All</option>
                <option value="@CacheSourceFilter.Overture">Overture</option>
                <option value="@CacheSourceFilter.Gadm">GADM</option>
            </select>
        </div>
        <div class="input-group">
            <label for="cache-search-filter">Country name or code</label>
            <input id="cache-search-filter"
                   type="text"
                   class="form-control"
                   placeholder="Switzerland or CHE"
                   @bind="_countrySearch"
                   @bind:event="oninput" />
        </div>
    </div>

    @if (GetFilteredRows().Count == 0)
    {
        <p>@(_overtureDivisionStatus.Count + _gadmDivisionStatus.Count == 0 ? "No country caches have been downloaded yet. Lookup and processing download them when needed." : "No caches match these filters. Try another country or source.")</p>
    }
    else
    {
        <div class="table-scroll" role="region" aria-label="Country cache files; scroll horizontally to see all columns" tabindex="0">
        <table class="data-table cache-table">
            <thead>
                <tr>
                    <th scope="col" aria-sort="@SortDirection(CacheSortColumn.Source)"><button type="button" class="table-sort-btn" @onclick="() => SortBy(CacheSortColumn.Source)"><span>Source</span><span class="sort-indicator">@SortIndicator(CacheSortColumn.Source)</span></button></th>
                    <th scope="col" aria-sort="@SortDirection(CacheSortColumn.Country)"><button type="button" class="table-sort-btn" @onclick="() => SortBy(CacheSortColumn.Country)"><span>Country</span><span class="sort-indicator">@SortIndicator(CacheSortColumn.Country)</span></button></th>
                    <th scope="col" aria-sort="@SortDirection(CacheSortColumn.AreaCount)"><button type="button" class="table-sort-btn" @onclick="() => SortBy(CacheSortColumn.AreaCount)"><span>Area Count</span><span class="sort-indicator">@SortIndicator(CacheSortColumn.AreaCount)</span></button></th>
                    <th scope="col" aria-sort="@SortDirection(CacheSortColumn.Version)"><button type="button" class="table-sort-btn" @onclick="() => SortBy(CacheSortColumn.Version)"><span>Version / Release</span><span class="sort-indicator">@SortIndicator(CacheSortColumn.Version)</span></button></th>
                    <th scope="col" aria-sort="@SortDirection(CacheSortColumn.Size)"><button type="button" class="table-sort-btn" @onclick="() => SortBy(CacheSortColumn.Size)"><span>Size</span><span class="sort-indicator">@SortIndicator(CacheSortColumn.Size)</span></button></th>
                    <th scope="col" aria-sort="@SortDirection(CacheSortColumn.DownloadedAt)"><button type="button" class="table-sort-btn" @onclick="() => SortBy(CacheSortColumn.DownloadedAt)"><span>Downloaded At</span><span class="sort-indicator">@SortIndicator(CacheSortColumn.DownloadedAt)</span></button></th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in GetFilteredRows())
                {
                    <tr>
                        <td><span class="source-badge @row.SourceCssClass">@row.SourceLabel</span></td>
                        <td><span class="cache-country-name">@CountryName(row.Iso3)</span><code>@row.Iso3</code></td>
                        <td>@row.RowCount.ToString("N0")</td>
                        <td>@(row.Version ?? "—")</td>
                        <td>@FormatFileSize(row.FileSizeBytes)</td>
                        <td>
                            @if (row.DownloadedAt is { } downloaded)
                            {
                                <LocalTimestamp Timestamp="@(new DateTimeOffset(DateTime.SpecifyKind(downloaded, DateTimeKind.Utc)))" />
                            }
                        </td>
                        <td class="table-actions-cell">
                            <div class="cache-row-actions">
                                <button @onclick="() => DeleteCache(row)"
                                        disabled="@(_busy || State.IsRunning)" aria-label="Delete @row.SourceLabel cache for @CountryName(row.Iso3)"
                                        class="btn btn-danger">
                                    Delete
                                </button>
                                <button @onclick="() => RedownloadCache(row)"
                                        disabled="@(_busy || State.IsRunning)" aria-label="Re-download @row.SourceLabel cache for @CountryName(row.Iso3)"
                                        class="btn btn-secondary">
                                    Re-download
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    }
    <details class="settings-disclosure">
        <summary>Cache Maintenance</summary>
        <p>Deleting a cache does not change Immich metadata. Lookup and processing download it again when needed. Re-download replaces the cached data and may change future results.</p>
        <div class="btn-row">
            <button class="btn btn-danger" @onclick="() => _deleteAllSource = CacheSource.Overture" disabled="@(_busy || State.IsRunning || _overtureDivisionStatus.Count == 0)">Review Deleting All Overture Caches</button>
            <button class="btn btn-danger" @onclick="() => _deleteAllSource = CacheSource.Gadm" disabled="@(_busy || State.IsRunning || _gadmDivisionStatus.Count == 0)">Review Deleting All GADM Caches</button>
        </div>
        @if (_deleteAllSource is { } source)
        {
            <p>Delete all @source country caches? They will be downloaded again on demand.</p>
            <div class="btn-row">
                <button class="btn btn-danger" @onclick="DeleteAllAsync" disabled="@(_busy || State.IsRunning)">Confirm Cache Deletion</button>
                <button class="btn btn-secondary" @onclick="() => _deleteAllSource = null" disabled="@_busy">Keep Caches</button>
            </div>
        }
    </details>
</section>
</div>

@code {
    private Dictionary<string, OvertureDivisionStatus> _overtureDivisionStatus = [];
    private Dictionary<string, GadmDivisionStatus> _gadmDivisionStatus = [];
    private bool _busy;
    private string? _result;
    private string? _error;
    private string _activity = "";
    private CacheSource? _deleteAllSource;
    private CacheSortColumn _sortColumn = CacheSortColumn.Source;
    private bool _sortAscending = true;
    private CacheSourceFilter _selectedSourceFilter = CacheSourceFilter.All;
    private string _countrySearch = string.Empty;

    protected override Task OnInitializedAsync()
    {
        State.OnChanged += Refresh;
        RefreshState();
        return Task.CompletedTask;
    }

    private void Refresh() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => State.OnChanged -= Refresh;

    private void RefreshState()
    {
        _overtureDivisionStatus = OvertureCache.GetStatus();
        _gadmDivisionStatus = GadmCache.GetStatus();
    }

    private string CountryName(string iso3) => CountryCodes.FindByAlpha3(iso3)?.DisplayName ?? iso3;

    private Task DeleteCache(CacheRow row) => RunMaintenanceAsync(async () =>
    {
        DeleteFile(row.Source, row.Iso3);
        await Task.CompletedTask;
    }, $"Deleting {row.SourceLabel} cache for {CountryName(row.Iso3)}…", $"Deleted {row.SourceLabel} cache for {CountryName(row.Iso3)}. It will download again when needed.");

    private Task RedownloadCache(CacheRow row) => RunMaintenanceAsync(async () =>
    {
        DeleteFile(row.Source, row.Iso3);
        if (row.Source == CacheSource.Overture)
        {
            await OvertureCache.EnsureDataAsync(row.Iso3);
        }
        else
        {
            await GadmCache.EnsureDataAsync(row.Iso3);
        }
    }, $"Re-downloading {row.SourceLabel} cache for {CountryName(row.Iso3)}…", $"Re-downloaded {row.SourceLabel} cache for {CountryName(row.Iso3)}.");

    private Task DeleteAllAsync()
    {
        if (_deleteAllSource is not { } source)
        {
            return Task.CompletedTask;
        }
        return RunMaintenanceAsync(async () =>
        {
            var codes = source == CacheSource.Overture ? _overtureDivisionStatus.Keys.ToArray() : _gadmDivisionStatus.Keys.ToArray();
            foreach (var code in codes)
            {
                DeleteFile(source, code);
            }
            _deleteAllSource = null;
            await Task.CompletedTask;
        }, $"Deleting all {source} caches…", $"Deleted all {source} caches. They will download again when needed.");
    }

    private void DeleteFile(CacheSource source, string iso3)
    {
        if (source == CacheSource.Overture)
        {
            OvertureCache.DeleteFile(iso3);
        }
        else
        {
            GadmCache.DeleteFile(iso3);
        }
    }

    private async Task RunMaintenanceAsync(Func<Task> action, string activity, string success)
    {
        if (_busy || State.IsRunning)
        {
            return;
        }
        using var maintenance = Processor.TryBeginMaintenance();
        if (maintenance is null)
        {
            _error = "Processing or another maintenance action is active. Wait for it to finish and retry.";
            return;
        }
        _busy = true;
        _activity = activity;
        _result = null;
        _error = null;
        try
        {
            await action();
            _result = success;
        }
        catch (Exception)
        {
            _error = "Cache maintenance failed. Some files may already have been deleted; a failed re-download can leave its cache unavailable. Check disk space, permissions, and network access, then retry. Immich metadata is unchanged.";
        }
        finally
        {
            RefreshState();
            _busy = false;
        }
    }

    private IReadOnlyList<CacheRow> GetFilteredRows()
    {
        var rows = _overtureDivisionStatus
            .Select(pair => new CacheRow(CacheSource.Overture, pair.Key, "Overture", pair.Value.RowCount, pair.Value.Release, pair.Value.FileSizeBytes, pair.Value.DownloadedAt))
            .Concat(_gadmDivisionStatus.Select(pair => new CacheRow(CacheSource.Gadm, pair.Key, "GADM", pair.Value.RowCount, pair.Value.Version, pair.Value.FileSizeBytes, pair.Value.DownloadedAt)));

        if (_selectedSourceFilter == CacheSourceFilter.Overture)
        {
            rows = rows.Where(row => row.Source == CacheSource.Overture);
        }
        else if (_selectedSourceFilter == CacheSourceFilter.Gadm)
        {
            rows = rows.Where(row => row.Source == CacheSource.Gadm);
        }

        if (!string.IsNullOrWhiteSpace(_countrySearch))
        {
            rows = rows.Where(row => (row.Iso3.Contains(_countrySearch.Trim(), StringComparison.OrdinalIgnoreCase) || CountryName(row.Iso3).Contains(_countrySearch.Trim(), StringComparison.OrdinalIgnoreCase)));
        }

        IOrderedEnumerable<CacheRow> ordered = _sortColumn switch
        {
            CacheSortColumn.Country => rows.OrderBy(row => CountryName(row.Iso3), StringComparer.OrdinalIgnoreCase),
            CacheSortColumn.AreaCount => rows.OrderBy(row => row.RowCount),
            CacheSortColumn.Version => rows.OrderBy(row => row.Version ?? string.Empty, StringComparer.OrdinalIgnoreCase),
            CacheSortColumn.Size => rows.OrderBy(row => row.FileSizeBytes ?? -1),
            CacheSortColumn.DownloadedAt => rows.OrderBy(row => row.DownloadedAt ?? DateTime.MinValue),
            _ => rows.OrderBy(row => row.SourceLabel, StringComparer.OrdinalIgnoreCase)
        };

        return (_sortAscending ? ordered : ordered.Reverse()).ToList();
    }

    private void SortBy(CacheSortColumn column)
    {
        if (_sortColumn == column)
        {
            _sortAscending = !_sortAscending;
            return;
        }

        _sortColumn = column;
        _sortAscending = true;
    }

    private string SortDirection(CacheSortColumn column) => _sortColumn != column ? "none" : _sortAscending ? "ascending" : "descending";

    private string SortIndicator(CacheSortColumn column)
    {
        if (_sortColumn != column)
        {
            return string.Empty;
        }

        return _sortAscending ? " ↑" : " ↓";
    }

    private static string FormatFileSize(long? bytes)
    {
        if (bytes is null || bytes < 0)
        {
            return "—";
        }

        string[] units = ["B", "KiB", "MiB", "GiB"];
        double size = bytes.Value;
        var unitIndex = 0;
        while (size >= 1024 && unitIndex < units.Length - 1)
        {
            size /= 1024;
            unitIndex++;
        }

        return unitIndex == 0
            ? $"{size:0} {units[unitIndex]}"
            : $"{size:0.##} {units[unitIndex]}";
    }

    private sealed record CacheRow(
        CacheSource Source,
        string Iso3,
        string SourceLabel,
        long RowCount,
        string? Version,
        long? FileSizeBytes,
        DateTime? DownloadedAt)
    {
        public string SourceCssClass => Source switch
        {
            CacheSource.Overture => "source-overture",
            CacheSource.Gadm => "source-gadm",
            _ => string.Empty
        };
    }

    private enum CacheSource
    {
        Overture,
        Gadm
    }

    private enum CacheSourceFilter
    {
        All,
        Overture,
        Gadm
    }

    private enum CacheSortColumn
    {
        Source,
        Country,
        AreaCount,
        Version,
        Size,
        DownloadedAt
    }

}

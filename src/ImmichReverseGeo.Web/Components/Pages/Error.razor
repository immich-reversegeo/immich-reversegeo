@page "/Error"
@using System.Diagnostics
@using Microsoft.AspNetCore.Http

<PageTitle>Something Went Wrong - Immich ReverseGeo</PageTitle>

<h2>Something Went Wrong</h2>
<p>The app could not complete this request. If it was a reset or maintenance action, check its result before trying again.</p>
<div class="btn-row">
    <a class="btn btn-secondary" href="" onclick="location.reload(); return false;">Reload Page</a>
    <a class="btn btn-primary" href="/">Return to Dashboard</a>
    <a class="btn btn-secondary" href="/logs">Inspect Recent Logs</a>
</div>

@if (ShowRequestId)
{
    <p>
        <strong>Request ID:</strong> <code>@RequestId</code>
    </p>
}

<p class="hint">Include the request ID when reporting a problem. The container or host logs may contain more detail than the recent activity list.</p>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}

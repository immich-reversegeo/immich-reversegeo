@using System.Threading
@page "/data/location-management/history"
@page "/data/location-management/history/{Id:guid}"
@rendermode InteractiveServer
@inject LocationChangeRepository Changes
@inject LocationManagementService Management
@inject PreviewCircuitLifetime Lifetime
@implements IDisposable

<PageTitle>@(Id is null ? "Change History" : "Change Details") - Immich ReverseGeo</PageTitle>
<h2>@(Id is null ? "Change History" : "Change Details")</h2>
<LocationManagementNav ActiveSection="history" />
<p class="hint">Review recorded changes, continue pending work, or undo selected changes.</p>
@if (_error is not null) { <p class="alert alert-error" role="alert">@_error</p> }
@if (_loading) { <p role="status">Loading change history…</p> }
else if (Id is null)
{
    <section class="settings-card wide-card">
        <p>Each operation saves the reviewed existing names, proposed names, and its results. History remains available even if you delete the saved scan.</p>
        <div class="table-scroll" role="region" aria-label="Change history results" tabindex="0"><table class="data-table">
            <thead><tr><th scope="col">Started</th><th scope="col">Selected</th><th scope="col">Applied</th><th scope="col">Skipped</th><th scope="col">Needs review</th><th scope="col">Pending</th><th scope="col">Undone</th><th scope="col">Pending undo</th><th scope="col">Operation</th></tr></thead>
            <tbody>@foreach (var operation in _operations.Take(25))
            {
                <tr @key="operation.Id"><td><LocalTimestamp Timestamp="operation.CreatedAt" /></td><td>@operation.Total</td><td>@operation.Applied</td><td>@operation.Skipped</td><td>@operation.NeedsReview</td><td>@operation.Pending</td><td>@operation.Undone</td><td>@operation.UndoPending</td>
                    <td><a class="text-link" href="@($"/data/location-management/history/{operation.Id}")">View</a></td></tr>
            }</tbody>
        </table></div>
        @if (_operations.Count == 0) { <p>No change operations on this page.</p> }
        <div class="btn-row">
            <button class="btn btn-secondary" disabled="@(_page == 1)" @onclick="async () => { _page--; await LoadAsync(); }">Previous</button>
            <button class="btn btn-secondary" disabled="@(_operations.Count <= 25)" @onclick="async () => { _page++; await LoadAsync(); }">Next</button>
            <button class="btn btn-secondary" @onclick="LoadAsync">Refresh</button>
        </div>
    </section>
}
else if (_operation is null) { <p>This change operation was not found.</p> }
else
{
    <section class="settings-card wide-card">
        <a class="text-link" href="/data/location-management/history">← All changes</a>
        <h3>@_operation.Total selected @(_operation.Total == 1 ? "asset" : "assets")</h3>
        <dl class="location-metadata"><div><dt>Started</dt><dd><LocalTimestamp Timestamp="_operation.CreatedAt" /></dd></div></dl>
        <dl class="location-metadata scan-metrics" aria-label="Change results">
            <div><dt>Changes applied</dt><dd>@_operation.Applied</dd></div>
            @if (_operation.Skipped > 0) { <div><dt>Skipped</dt><dd>@_operation.Skipped</dd></div> }
            @if (_operation.NeedsReview > 0) { <div><dt>Check in Immich</dt><dd>@_operation.NeedsReview</dd></div> }
            @if (_operation.Pending > 0) { <div><dt>Waiting to apply</dt><dd>@_operation.Pending</dd></div> }
            @if (_operation.Undone > 0) { <div><dt>Changes undone</dt><dd>@_operation.Undone</dd></div> }
            @if (_operation.UndoPending > 0) { <div><dt>Waiting to undo</dt><dd>@_operation.UndoPending</dd></div> }
        </dl>
        <p><a class="text-link" href="@($"/data/location-management/scans/{_operation.ScanId}")">Original saved scan</a> (if retained).</p>
        @if (_operation.NeedsReview > 0)
        {
            <p class="alert alert-warning" role="alert">Some write outcomes are uncertain. Check the affected assets in Immich and run a new scan before making another change.</p>
        }
        <p class="hint">Undo restores previous names when the applied names, coordinates, and metadata revision still match. Later edits are skipped.</p>
        <div class="btn-row">
            <button class="btn btn-secondary" disabled="@_busy" @onclick="SelectUndoPage">Select Undo on This Page</button>
            <button class="btn btn-secondary" disabled="@_busy" @onclick="_selected.Clear">Clear Selection</button>
        </div>
        <div class="btn-row">
            <button class="btn btn-secondary" disabled="@_busy" @onclick="LoadAsync">Refresh Results</button>
            <button class="btn btn-secondary" disabled="@(_busy || _operation.Pending == 0)" @onclick="() => PrepareResume(false)">Resume Pending Apply</button>
            <button class="btn btn-secondary" disabled="@(_busy || _operation.UndoPending == 0)" @onclick="() => PrepareResume(true)">Resume Pending Undo</button>
            <button class="btn btn-secondary" disabled="@(_busy || _selected.Count == 0)" @onclick="PrepareUndo">Review Selected Undo (@_selected.Count)</button>
        </div>
        @if (_busy)
        {
            <p role="status">Updating selected assets…</p>
            <button class="btn btn-secondary" @onclick="Cancel">Cancel Remaining Work</button>
        }
        @if (_confirmation is not null)
        {
            <div class="location-confirmation">
                <h3>@_confirmation</h3>
                @if (_undoIds.Length > 0)
                {
                    <LocationChangeTable Rows="_items.Where(item => _undoIds.Contains(item.AssetId)).Select(item => item.Snapshot).Skip((_confirmPage - 1) * 100).Take(100)" Reverse="true" />
                    <div class="btn-row">
                        <button class="btn btn-secondary" disabled="@(_busy || _confirmPage == 1)" @onclick="() => _confirmPage--">Previous 100</button>
                        <button class="btn btn-secondary" disabled="@(_busy || _confirmPage * 100 >= _undoIds.Length)" @onclick="() => _confirmPage++">Next 100</button>
                    </div>
                }
                <p>Take an Immich database backup before continuing. Already completed and uncertain writes will not be retried.</p>
                <label><input type="checkbox" @bind="_acknowledged" disabled="@_busy" /> I have reviewed this operation and understand that it updates Immich.</label>
                <div class="btn-row">
                    <button class="btn btn-primary" disabled="@(_busy || !_acknowledged)" @onclick="ExecuteAsync">Confirm</button>
                    <button class="btn btn-secondary" disabled="@_busy" @onclick="() => _confirmation = null">Keep Results</button>
                </div>
            </div>
        }
        <h3>Operation results — page @_itemPage</h3>
        <div class="table-scroll" role="region" aria-label="Change history results" tabindex="0"><table class="data-table">
            <thead><tr><th scope="col">Undo</th><th scope="col">Asset GUID</th><th scope="col">Previous names</th><th scope="col">Applied proposal</th><th scope="col">Result</th></tr></thead>
            <tbody>@foreach (var item in _items.Skip((_itemPage - 1) * 100).Take(100))
            {
                <tr @key="item.AssetId">
                    <td><input type="checkbox" aria-label="Select asset @item.AssetId for undo" checked="@_selected.Contains(item.AssetId)" disabled="@(_busy || !item.CanUndo)" @onchange="args => SelectUndo(item, args.Value is true)" /></td>
                    <td><code>@item.AssetId</code><div class="hint"><LocalTimestamp Timestamp="item.UpdatedAt" /></div></td>
                    <td><div>City: @LocationTextDiff.DisplayValue(item.Snapshot.Asset.Existing.City)</div><div>State: @LocationTextDiff.DisplayValue(item.Snapshot.Asset.Existing.State)</div><div>Country: @LocationTextDiff.DisplayValue(item.Snapshot.Asset.Existing.Country)</div></td>
                    <td><div>City: @LocationTextDiff.DisplayValue(item.Snapshot.Proposed?.City)</div><div>State: @LocationTextDiff.DisplayValue(item.Snapshot.Proposed?.State)</div><div>Country: @LocationTextDiff.DisplayValue(item.Snapshot.Proposed?.Country)</div></td>
                    <td>@item.Label @if (item.Message is not null) { <div class="hint">@item.Message</div> }</td>
                </tr>
            }</tbody>
        </table></div>
        <div class="btn-row">
            <button class="btn btn-secondary" disabled="@(_busy || _itemPage == 1)" @onclick="() => _itemPage--">Previous 100</button>
            <button class="btn btn-secondary" disabled="@(_busy || _itemPage * 100 >= _items.Count)" @onclick="() => _itemPage++">Next 100</button>

        </div>
    </section>
}

@code {
    [Parameter] public Guid? Id { get; set; }
    private Guid? _loadedId;
    private IReadOnlyList<LocationChangeOperation> _operations = [];
    private LocationChangeOperation? _operation;
    private IReadOnlyList<LocationChangeItem> _items = [];
    private readonly HashSet<Guid> _selected = [];
    private Guid[] _undoIds = [];
    private long _loadVersion;
    private bool _loading;
    private bool _busy;
    private bool _disposed;
    private bool _undo;
    private bool _acknowledged;
    private int _page = 1;
    private int _itemPage = 1;
    private int _confirmPage = 1;
    private string? _error;
    private string? _confirmation;
    private CancellationTokenSource? _cts;

    protected override void OnInitialized() => Lifetime.Disconnected += Cancel;
    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId != Id)
        {
            Cancel();
            _loadedId = Id;
            _selected.Clear();
            _confirmation = null;
            _page = _itemPage = 1;
        }
        await LoadAsync();
    }
    private async Task LoadAsync()
    {
        var version = ++_loadVersion;
        var requestedId = Id;
        var requestedPage = _page;
        _loading = true;
        _error = null;
        try
        {
            var operations = await Changes.GetOperationsAsync(requestedPage, requestedId);
            var items = requestedId is { } id ? await Changes.GetItemsAsync(id) : [];
            if (_disposed || version != _loadVersion || requestedId != Id)
            {
                return;
            }
            _operations = operations;
            _operation = requestedId is null ? null : operations.SingleOrDefault();
            _items = items;
            _selected.RemoveWhere(id => !_items.Any(item => item.AssetId == id && item.CanUndo));
        }
        catch (Exception ex)
        {
            if (!_disposed && version == _loadVersion)
            {
                _error = "Could not load change history: " + ex.Message;
            }
        }
        finally
        {
            if (version == _loadVersion)
            {
                _loading = false;
            }
        }
    }
    private void SelectUndo(LocationChangeItem item, bool selected)
    {
        if (selected && item.CanUndo) { _selected.Add(item.AssetId); }
        else { _selected.Remove(item.AssetId); }
    }
    private void SelectUndoPage()
    {
        foreach (var item in _items.Skip((_itemPage - 1) * 100).Take(100)) { SelectUndo(item, true); }
    }
    private void PrepareUndo()
    {
        _undoIds = _selected.ToArray();
        _undo = true;
        _confirmation = $"Undo {_undoIds.Length} selected changes";
        _confirmPage = 1;
        _acknowledged = false;
    }
    private void PrepareResume(bool undo)
    {
        _undoIds = [];
        _undo = undo;
        _confirmation = undo ? $"Resume {_operation!.UndoPending} pending undo writes" : $"Resume {_operation!.Pending} pending apply writes";
        _acknowledged = false;
    }
    private async Task ExecuteAsync()
    {
        if (_busy || !_acknowledged || Id is not { } id) { return; }
        _busy = true;
        _cts = new CancellationTokenSource();
        _error = null;
        try
        {
            if (_undoIds.Length > 0) { await Changes.QueueUndoAsync(id, _undoIds); }
            _confirmation = null;
            await Management.RunAsync(id, _undo, async () =>
            {
                if (!_disposed && Id == id)
                {
                    _operation = (await Changes.GetOperationsAsync(id: id)).SingleOrDefault();
                    await InvokeAsync(StateHasChanged);
                }
            }, _cts.Token);
        }
        catch (Exception ex) { _error = ex.Message; }
        finally
        {
            _busy = false;
            _cts.Dispose();
            _cts = null;
            _selected.Clear();
            if (!_disposed)
            {
                var actionError = _error;
                await LoadAsync();
                _error ??= actionError;
            }
        }
    }
    private void Cancel() => _cts?.Cancel();
    public void Dispose()
    {
        _disposed = true;
        Lifetime.Disconnected -= Cancel;
        Cancel();
    }
}

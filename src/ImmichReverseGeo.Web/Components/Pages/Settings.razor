@page "/settings"
@rendermode InteractiveServer
@inject ConfigService Config
@inject IJSRuntime JS
@using System.IO
@using System.Text.Json
@inject ImmichDbRepository Db

<PageTitle>Settings - Immich ReverseGeo</PageTitle>
<NavigationLock ConfirmExternalNavigation="@HasChanges" OnBeforeInternalNavigation="ConfirmNavigation" />
<h2>Settings</h2>

@if (_loadError is not null)
{
    <div class="alert alert-error" role="alert">@_loadError</div>
    <button class="btn btn-secondary" @onclick="LoadSettings">Retry loading settings</button>
}
else if (!_saveState.IsLoaded)
{
    <p role="status">Loading settings...</p>
}
else
{
@if (_saveState.Error is not null)
{
    <div class="alert alert-error" role="alert">@_saveState.Error</div>
}
<section class="settings-card">
    <details class="settings-disclosure">
        <summary>Database Connection Details</summary>
        <p class="section-intro">Pre-populated from environment variables. These values come from the current running process, so if you change Windows or user environment variables after Visual Studio was already open, restart Visual Studio before running again.</p>
        <div class="form-group">
            <label>Host</label>
            <input value="@_dbHost" class="form-control env-readonly" readonly aria-readonly="true" />
            <div class="hint env-field-hint">Environment value</div>
        </div>
        <div class="form-group">
            <label>Port</label>
            <input type="number" value="@_dbPort" class="form-control env-readonly" readonly aria-readonly="true" />
        </div>
        <div class="form-group">
            <label>Database</label>
            <input value="@_dbName" class="form-control env-readonly" readonly aria-readonly="true" />
        </div>
        <div class="form-group">
            <label>Username</label>
            <input value="@_dbUser" class="form-control env-readonly" readonly aria-readonly="true" />
        </div>
        <div class="form-group">
            <label>Password</label>
            <input type="password" value="@_dbPassword" class="form-control env-readonly" readonly aria-readonly="true" />
        </div>
        <div class="btn-row">
            <button @onclick="TestConnection" class="btn btn-secondary" disabled="@_testingConnection">@(_testingConnection ? "Testing..." : "Test Connection")</button>
            @if (_connResult.HasValue)
            {
                <span class="@(_connResult.Value ? "ok" : "fail")">
                    @(_connResult.Value ? "✓ Connected" : "✗ Failed")
                </span>
            }
            @if (_connectionError is not null)
            {
                <span class="fail" role="alert">@_connectionError</span>
            }
        </div>
        <p class="hint">Testing checks the environment-backed connection. It does not save settings.</p>
    </details>
</section>

<section class="settings-card">
    <h3>Schedule</h3>
    <p class="section-intro">Choose when automatic processing should run. Manual runs from the dashboard still work at any time.</p>
    <div class="form-group">
        <label><input type="checkbox" @bind="_cfg.Schedule.Enabled" /> Run processing automatically on a schedule</label>
    </div>

    @if (_cfg.Schedule.Enabled)
    {
        <div class="schedule-builder">
            <div class="form-group">
                <label>How often?</label>
                <select @bind="_schedule.Mode" class="form-control">
                    <option value="@ScheduleEditorState.ModeHourly">Every hour</option>
                    <option value="@ScheduleEditorState.ModeEveryMinutes">Every few minutes</option>
                    <option value="@ScheduleEditorState.ModeEveryHours">Every few hours</option>
                    <option value="@ScheduleEditorState.ModeDaily">Every day</option>
                    <option value="@ScheduleEditorState.ModeWeekly">Once a week</option>
                    <option value="@ScheduleEditorState.ModeCustom">Advanced custom schedule</option>
                </select>
            </div>

            @if (_schedule.Mode == ScheduleEditorState.ModeHourly)
            {
                <div class="form-group">
                    <label>Minute past the hour</label>
                    <input type="number" min="0" max="59" @bind="_schedule.Minute" class="form-control" />
                </div>
            }

            @if (_schedule.Mode == ScheduleEditorState.ModeEveryMinutes)
            {
                <div class="form-group">
                    <label>Run every</label>
                    <select @bind="_schedule.MinuteInterval" class="form-control">
                        <option value="5">5 minutes</option>
                        <option value="10">10 minutes</option>
                        <option value="15">15 minutes</option>
                        <option value="30">30 minutes</option>
                    </select>
                </div>
            }

            @if (_schedule.Mode == ScheduleEditorState.ModeEveryHours)
            {
                <div class="form-group">
                    <label>Run every</label>
                    <select @bind="_schedule.HourInterval" class="form-control">
                        <option value="2">2 hours</option>
                        <option value="3">3 hours</option>
                        <option value="4">4 hours</option>
                        <option value="6">6 hours</option>
                        <option value="8">8 hours</option>
                        <option value="12">12 hours</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Minute past the hour</label>
                    <input type="number" min="0" max="59" @bind="_schedule.Minute" class="form-control" />
                </div>
            }

            @if (_schedule.Mode == ScheduleEditorState.ModeDaily || _schedule.Mode == ScheduleEditorState.ModeWeekly)
            {
                <div class="form-group">
                    <label>What time?</label>
                    <input type="time" value="@_schedule.Time" @onchange="OnScheduleTimeChanged" class="form-control" />
                </div>
            }

            @if (_schedule.Mode == ScheduleEditorState.ModeWeekly)
            {
                <div class="form-group">
                    <label>Which day?</label>
                    <select @bind="_schedule.WeeklyDay" class="form-control">
                        <option value="MON">Monday</option>
                        <option value="TUE">Tuesday</option>
                        <option value="WED">Wednesday</option>
                        <option value="THU">Thursday</option>
                        <option value="FRI">Friday</option>
                        <option value="SAT">Saturday</option>
                        <option value="SUN">Sunday</option>
                    </select>
                </div>
            }
        </div>

        @if (_schedule.Mode == ScheduleEditorState.ModeCustom)
        {
            <div class="form-group">
                <label>Cron Expression</label>
                <input @bind="_cfg.Schedule.Cron" class="form-control" />
                <span class="hint">Use standard 5-part cron syntax. Example: <code>0 2 * * *</code> runs every day at 02:00.</span>
            </div>
        }
        else
        {
            <div class="schedule-summary">
                <div class="schedule-summary-label">Scheduled Run</div>
                <div class="schedule-summary-value">@_schedule.Describe()</div>
                <div class="schedule-summary-detail">Cron: <code>@_schedule.ToCron()</code></div>
            </div>
        }
    }
    else
    {
        <div class="schedule-summary schedule-summary-muted">
            <div class="schedule-summary-label">Automatic Processing</div>
            <div class="schedule-summary-value">Disabled</div>
            <div class="schedule-summary-detail">Only manual runs from the dashboard will be available.</div>
        </div>
    }
</section>

<section class="settings-card">
    <h3>Processing</h3>
    <div class="form-group">
        <label><input type="checkbox" @bind="_cfg.Processing.LowMemoryMode" /> Low-memory mode</label>
        <span class="hint">Uses one processing worker, batches of at most 25 assets, and less memory for downloads. Country boundaries are read from disk as needed. Processing can be slower. Save before starting a run; work already in progress keeps its current limits.</span>
    </div>
    <div class="form-group">
        <label>Batch Size <input type="number" @bind="_cfg.Processing.BatchSize" /></label>
    </div>
    <div class="form-group">
        <label>Batch Delay (ms) <input type="number" @bind="_cfg.Processing.BatchDelayMs" /></label>
    </div>
    <div class="form-group">
        <label>Max Parallelism <input type="number" min="1" max="32" @bind="_cfg.Processing.MaxDegreeOfParallelism" /></label>
        <span class="hint">How many assets can be resolved in parallel within a batch. Start with 4 and increase carefully. Low-memory mode uses one worker without changing this saved value.</span>
    </div>
    <div class="form-group">
        <label><input type="checkbox" @bind="_cfg.Processing.UseAirportInfrastructure" /> Use bundled airport infrastructure to improve city matching when it fits</label>
        <span class="hint">Turn this off if you prefer commune or city names over airport names for photos taken on airport grounds.</span>
    </div>
    <div class="form-group">
        <label><input type="checkbox" @bind="_cfg.Processing.UseGadmAdministrativeAreas" /> Enable GADM administrative areas as an optional source</label>
        <span class="hint">Uses on-demand GADM country caches for state and city matching when enabled.</span>
    </div>
    @if (_cfg.Processing.UseGadmAdministrativeAreas)
    {
        <div class="form-group">
            <label><input type="checkbox" @bind="_cfg.Processing.PreferGadmAdministrativeAreas" /> Prefer GADM administrative results over cached Overture divisions</label>
            <span class="hint">Turn this on if GADM gives you better state or city names for your library. Leave it off to keep Overture primary and use GADM only as fallback.</span>
        </div>
        <div class="form-group">
            <label><input type="checkbox" @bind="_cfg.Processing.UseGadmTerritoryFallbacks" /> Try related or shared GADM country packages</label>
            <span class="hint">Try related territory packages, or use China's GADM administrative data for Hong Kong and Macao. The resolved country stays unchanged; shared-package results must match the coordinate.</span>
        </div>
    }
    <div class="form-group">
        <label><input type="checkbox" @bind="_cfg.Processing.VerboseLogging" /> Verbose logging (log every asset)</label>
    </div>
</section>

<section class="settings-card">
    <h3>City Resolver</h3>
    <p class="section-intro">Country-specific city matching now has its own dedicated page so the main settings stay focused.</p>
    <div class="btn-row">
        <a class="btn btn-secondary" href="/city-resolver">Open City Resolver</a>
    </div>
</section>

<div class="btn-row">
    <span role="status">@(_saveState.IsSaving ? "Saving..." : HasChanges ? "Unsaved changes" : "All changes saved")</span>
    <button @onclick="Save" class="btn btn-primary" disabled="@(_saveState.IsSaving || !HasChanges)">@(_saveState.IsSaving ? "Saving..." : "Save changes")</button>
</div>

}

@code {
    private AppConfig _cfg = new();
    private string _dbHost = "", _dbName = "", _dbUser = "", _dbPassword = "";
    private int _dbPort = 5432;
    private readonly SettingsSaveState _saveState = new();
    private string? _loadError;
    private bool HasChanges => _saveState.HasChanges(BuildSaveConfig());
    private bool _testingConnection;
    private string? _connectionError;
    private bool? _connResult;
    private ScheduleEditorState _schedule = new();

    protected override Task OnInitializedAsync() => LoadSettings();

    private async Task LoadSettings()
    {
        _loadError = null;
        try
        {
            _cfg = await Config.GetConfigAsync();
            var db = Config.GetDbSettings();
            _dbHost = db.Host;
            _dbPort = db.Port;
            _dbName = db.Database;
            _dbUser = db.Username;
            _schedule = ScheduleEditorState.FromCron(_cfg.Schedule.Cron);
            _saveState.Load(BuildSaveConfig());
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or JsonException)
        {
            _loadError = "Settings could not be loaded. Check settings.json and its permissions, then retry. The file has been left unchanged.";
        }
    }
    private async Task TestConnection()
    {
        if (_testingConnection)
        {
            return;
        }
        _testingConnection = true;
        _connResult = null;
        _connectionError = null;
        try
        {
            _connResult = await Db.TestConnectionAsync();
        }
        catch (Exception)
        {
            _connectionError = "Connection test failed. Check the database settings and retry.";
        }
        finally
        {
            _testingConnection = false;
        }
    }

    private async Task Save()
    {
        var snapshot = _saveState.BeginSave(BuildSaveConfig());
        if (snapshot is null)
        {
            return;
        }

        try
        {
            await Config.UpdateConfigAsync(latest =>
            {
                var cityResolver = latest.Processing.CityResolver;
                latest.Schedule = snapshot.Schedule;
                latest.Processing = snapshot.Processing;
                latest.Processing.CityResolver = cityResolver;
            });
            _saveState.CompleteSave();
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or JsonException)
        {
            _saveState.FailSave("Could not save settings. Your edits are still here; check the config volume and try again.");
        }
    }

    private AppConfig BuildSaveConfig()
    {
        var snapshot = JsonSerializer.Deserialize<AppConfig>(JsonSerializer.Serialize(_cfg))!;
        if (_schedule.Mode != ScheduleEditorState.ModeCustom)
        {
            snapshot.Schedule.Cron = _schedule.ToCron();
        }
        return snapshot;
    }

    private async Task ConfirmNavigation(LocationChangingContext context)
    {
        if (HasChanges && !await JS.InvokeAsync<bool>("confirm", "You have unsaved settings. Leave this page and discard them?"))
        {
            context.PreventNavigation();
        }
    }

    private void OnScheduleTimeChanged(ChangeEventArgs e)
    {
        _schedule.Time = e.Value?.ToString() ?? "02:00";
    }
}
